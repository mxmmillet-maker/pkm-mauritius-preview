---
/*
  Bloc "à partir de" — le prix d'appel toujours en haut de page.
  Le prix est un nombre passé en props, jamais un texte figé dans une image
  (règle non négociable du brief design, §5 et doc stratégie §6).
*/
const { label, amount, currency = 'Rs', detail } = Astro.props;
---
<div class="from">
  <span class="lbl">{label}</span>
  <div class="amt">{amount} <small>{currency}</small></div>
  {detail && <span class="det">{detail}</span>}
</div>

<style>
  .from {
    border: 1px solid var(--line); border-radius: var(--radius-md);
    padding: 16px 18px; background: #fff; box-shadow: var(--shadow);
  }
  .lbl {
    font-family: var(--font-display); font-weight: 500; font-size: .72rem;
    letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft);
  }
  .amt {
    font-family: var(--font-display); font-weight: 600; font-size: 1.5rem;
    letter-spacing: -.02em; line-height: 1.1; margin-top: 3px;
    font-variant-numeric: tabular-nums;
  }
  .amt small { font-family: var(--font-body); font-weight: 400; font-size: .8rem; color: var(--ink-soft); margin-left: 5px; }
  .det { display: block; font-size: .82rem; color: var(--ink-soft); margin-top: 5px; line-height: 1.45; }
</style>
