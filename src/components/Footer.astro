---
const { logoSrc = '/logo-white.png', columns = [] } = Astro.props;
// columns : [{ title, links: [{ label, href }] }]
---
<footer>
  <img class="footer-logo" src={logoSrc} alt="PKM — Paradise Kitesurfing Mauritius" width="800" height="293" />
  <div class="fgrid">
    {columns.map((col) => (
      <div>
        <h4>{col.title}</h4>
        {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    ))}
  </div>
  <slot />
</footer>

<style>
  footer {
    background: var(--ink); color: #C3D6D4;
    padding: 34px max(20px, calc((100vw - 960px) / 2)) 40px;
    font-size: .86rem;
  }
  footer h4 { font-family: var(--font-display); color: #fff; font-size: .95rem; margin: 0 0 8px; }
  footer a { color: #C3D6D4; text-decoration: none; display: block; padding: 5px 0; }
  .footer-logo { display: block; width: auto; height: 58px; margin-bottom: 22px; }
  .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 22px; }
  @media (min-width: 720px) { .fgrid { grid-template-columns: repeat(3, 1fr); } }
</style>
