---
import { LOCALES } from '../lib/i18n';

/*
  locale       : langue de la page courante ('fr' | 'en' | 'de' | ...)
  translations : { fr: '/fr/', en: '/en/', de: '/de/' } — équivalents réels de CETTE page
  logoSrc      : chemin du logo (fond clair)
  nav          : [{ label, href }]
*/
const { locale, translations = {}, logoSrc = '/logo.png', nav = [], scrollRefresh = false } = Astro.props;
const liveLocales = Object.entries(LOCALES).filter(([, l]) => l.live);
const currentPath = Astro.url.pathname;
---
<header class:list={['topbar', { 'topbar--refresh': scrollRefresh }]}>
  <a class="logo" href={`/${locale}/`}>
    <img src={logoSrc} alt="PKM — Paradise Kitesurfing Mauritius" width="800" height="293" />
  </a>
  {scrollRefresh && (
    <nav class="desktop-main" aria-label={locale === 'fr' ? 'Navigation principale' : locale === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      {nav.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  )}
  <div class="topright">
    <nav class="lang" aria-label={locale === 'fr' ? 'Langue' : locale === 'de' ? 'Sprache' : 'Language'}>
      {liveLocales.map(([code, l]) => (
        translations[code]
          ? <a class:list={['pill', { on: code === locale }]} href={translations[code]} aria-current={code === locale ? 'page' : undefined}>{l.label}</a>
          : null
      ))}
    </nav>
    <button class="burger" id="burger" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
      <span></span>
    </button>
  </div>
</header>

<nav id="mobile-menu" class:list={['menu', { 'menu--refresh': scrollRefresh }]} aria-label={locale === 'fr' ? 'Navigation principale' : locale === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
  {nav.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
</nav>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 40;
    background: rgba(255,255,255,.92); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 18px;
  }
  .desktop-main { display: none; }
  .logo { display: flex; align-items: center; text-decoration: none; }
  .logo img { display: block; width: auto; height: 42px; }
  .topright { display: flex; align-items: center; gap: 6px; }
  .lang { display: flex; gap: 6px; }
  .pill {
    font-family: var(--font-display); font-weight: 600; font-size: .74rem;
    border: 1px solid var(--line); background: #fff; border-radius: var(--radius-pill);
    padding: 6px 10px; color: var(--ink-soft); text-decoration: none;
  }
  .pill.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .burger {
    width: 40px; height: 40px; border: 0; background: var(--surface);
    border-radius: 11px; display: grid; place-items: center; cursor: pointer;
  }
  .burger span, .burger span::before, .burger span::after {
    display: block; width: 17px; height: 2px; background: var(--ink); border-radius: 2px;
  }
  .burger span { position: relative; }
  .burger span::before, .burger span::after { content: ""; position: absolute; left: 0; }
  .burger span::before { top: -5px; }
  .burger span::after { top: 5px; }

  .menu { display: none; border-bottom: 1px solid var(--line); background: #fff; padding: 6px 12px 12px; }
  .menu.open { display: block; }
  .menu a {
    display: block; padding: 12px 8px; font-family: var(--font-display); font-weight: 600;
    font-size: 1rem; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--surface);
  }
  .menu a:last-child { border: 0; }
  .menu a[aria-current="page"] { color: var(--coral); }

  @media (min-width: 900px) {
    .topbar { padding-inline: max(24px, calc((100vw - 1120px) / 2)); }
    .logo img { height: 46px; }
    .burger { display: none; }
    .menu {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 6px max(24px, calc((100vw - 1120px) / 2));
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .menu a { border: 0; padding: 9px 11px; font-size: .9rem; border-radius: var(--radius-pill); }
    .menu a:hover, .menu a:focus-visible { background: var(--surface); }

    .topbar--refresh {
      height: var(--topbar-height, 84px); padding-block: 0;
      transition: height .22s cubic-bezier(.2,.7,.3,1), background .22s ease, border-color .22s ease;
    }
    .topbar--refresh .logo img { height: 40px; transition: height .22s cubic-bezier(.2,.7,.3,1); }
    .topbar--refresh .desktop-main { align-items: center; justify-content: center; gap: 2px; margin-inline: auto 18px; }
    .topbar--refresh .desktop-main a {
      padding: 9px 10px; border-radius: var(--radius-pill); color: var(--ink); text-decoration: none;
      font-family: var(--font-display); font-size: .82rem; font-weight: 600; white-space: nowrap;
    }
    .topbar--refresh .desktop-main a:hover, .topbar--refresh .desktop-main a:focus-visible { background: var(--surface); }
    .topbar--refresh .desktop-main a[aria-current="page"] { color: var(--coral); }
    :global(body.is-scrolled) .topbar--refresh { border-bottom-color: var(--line); background: rgba(255,255,255,.96); }
    :global(body.is-scrolled) .topbar--refresh .logo img { height: 30px; }
  }

  @media (min-width: 1080px) {
    .topbar--refresh .desktop-main { display: flex; }
    .menu--refresh { display: none; }
  }

  @media (max-width: 899px) {
    .menu.open {
      position: fixed;
      top: var(--topbar-height, 66px);
      right: 0;
      left: 0;
      z-index: 39;
      max-height: calc(100dvh - var(--topbar-height, 66px) - 76px - env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      box-shadow: var(--shadow);
    }
    .topbar--refresh {
      height: var(--topbar-height, 66px); padding-block: 0;
      transition: height .22s cubic-bezier(.2,.7,.3,1), background .22s ease, border-color .22s ease;
    }
    .topbar--refresh .logo img { height: 34px; transition: height .22s cubic-bezier(.2,.7,.3,1); }
    :global(body.is-scrolled) .topbar--refresh { border-bottom-color: var(--line); background: rgba(255,255,255,.96); }
    :global(body.is-scrolled) .topbar--refresh .logo img { height: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar--refresh, .topbar--refresh .logo img { transition: none; }
  }
</style>

<script>
  // Menu mobile — vanilla JS minimal, pas de framework (voir brief : site économe).
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const open = menu.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });
</script>
