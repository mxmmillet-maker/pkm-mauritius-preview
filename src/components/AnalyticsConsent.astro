---
const { locale = 'fr' } = Astro.props;
const measurementId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '').trim();
const analyticsEnabled = /^G-[A-Z0-9]+$/i.test(measurementId);
const privacyHref = locale === 'fr'
  ? '/fr/confidentialite/'
  : locale === 'de'
    ? '/de/datenschutz/'
    : '/en/privacy/';
const copy = {
  fr: {
    label: 'Préférences de mesure d’audience',
    text: 'Avec ton accord, nous mesurons les visites et les clics utiles pour améliorer le site. Aucun suivi publicitaire.',
    details: 'En savoir plus',
    accept: 'Accepter la mesure',
    decline: 'Continuer sans',
    manage: 'Gérer mes cookies',
  },
  en: {
    label: 'Analytics preferences',
    text: 'With your permission, we measure visits and useful clicks to improve the site. No advertising tracking.',
    details: 'Learn more',
    accept: 'Allow analytics',
    decline: 'Continue without',
    manage: 'Manage cookies',
  },
  de: {
    label: 'Analyse-Einstellungen',
    text: 'Mit deiner Zustimmung messen wir Besuche und wichtige Klicks, um die Website zu verbessern. Kein Werbetracking.',
    details: 'Mehr erfahren',
    accept: 'Analyse erlauben',
    decline: 'Ohne fortfahren',
    manage: 'Cookies verwalten',
  },
}[locale] ?? {
  label: 'Analytics preferences',
  text: 'With your permission, we measure visits and useful clicks to improve the site. No advertising tracking.',
  details: 'Learn more',
  accept: 'Allow analytics',
  decline: 'Continue without',
  manage: 'Manage cookies',
};
---

{analyticsEnabled && (
  <>
    <aside class="analytics-consent" data-analytics-consent hidden aria-label={copy.label}>
      <p>{copy.text} <a href={privacyHref}>{copy.details}</a></p>
      <div>
        <button type="button" data-consent="granted">{copy.accept}</button>
        <button type="button" class="secondary" data-consent="denied">{copy.decline}</button>
      </div>
    </aside>
    <button type="button" class="analytics-settings" data-analytics-settings hidden>
      {copy.manage}
    </button>
  </>
)}

<style>
  .analytics-consent {
    position: fixed; z-index: 90; right: 16px; bottom: calc(78px + env(safe-area-inset-bottom));
    width: min(420px, calc(100vw - 32px)); padding: 16px; border: 1px solid var(--line);
    border-radius: 16px; background: #fff; box-shadow: 0 18px 52px rgba(10,44,48,.2);
  }
  .analytics-consent p { margin: 0 0 12px; color: var(--ink-soft); font-size: .82rem; line-height: 1.5; }
  .analytics-consent p a { color: var(--sage-deep); font-weight: 600; }
  .analytics-consent div { display: flex; flex-wrap: wrap; gap: 8px; }
  .analytics-consent button,
  .analytics-settings {
    min-height: var(--tap-min); padding: 9px 14px; border: 0; border-radius: var(--radius-pill);
    background: var(--ink); color: #fff; font: 600 .78rem var(--font-display); cursor: pointer;
  }
  .analytics-consent button.secondary { border: 1px solid var(--line); background: #fff; color: var(--ink); }
  .analytics-settings {
    position: fixed; z-index: 89; left: 12px; bottom: calc(78px + env(safe-area-inset-bottom));
    min-height: 36px; padding: 7px 11px; border: 1px solid var(--line); background: #fff;
    color: var(--ink-soft); box-shadow: 0 8px 24px rgba(10,44,48,.12); font-size: .7rem;
  }
  @media (min-width: 900px) {
    .analytics-consent { bottom: 20px; }
    .analytics-settings { bottom: 16px; }
  }
</style>

<script define:vars={{ measurementId, analyticsEnabled }}>
  const consentKey = 'pkm_analytics_consent';
  const consentLifetime = 180 * 24 * 60 * 60 * 1000;
  const consentBox = document.querySelector('[data-analytics-consent]');
  const settingsButton = document.querySelector('[data-analytics-settings]');
  let analyticsLoaded = false;

  const readConsent = () => {
    try {
      const raw = localStorage.getItem(consentKey);
      if (!raw) return null;
      const saved = JSON.parse(raw);
      const isValidValue = saved?.value === 'granted' || saved?.value === 'denied';
      const isFresh = Number.isFinite(saved?.savedAt) && Date.now() - saved.savedAt < consentLifetime;
      if (isValidValue && isFresh) return saved.value;
      localStorage.removeItem(consentKey);
    } catch {
      try { localStorage.removeItem(consentKey); } catch {}
    }
    return null;
  };

  const writeConsent = (value) => {
    try { localStorage.setItem(consentKey, JSON.stringify({ value, savedAt: Date.now() })); } catch {}
  };

  const clearAnalyticsCookies = () => {
    const cookieNames = document.cookie
      .split(';')
      .map((cookie) => cookie.split('=')[0]?.trim())
      .filter((name) => name?.startsWith('_ga'));
    const hostParts = window.location.hostname.split('.');
    const registrableDomain = hostParts.length > 1 ? `.${hostParts.slice(-2).join('.')}` : '';
    cookieNames.forEach((name) => {
      document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
      if (registrableDomain) {
        document.cookie = `${name}=; Max-Age=0; path=/; domain=${registrableDomain}; SameSite=Lax`;
      }
    });
  };

  const disableAnalytics = () => {
    if (!measurementId) return;
    window[`ga-disable-${measurementId}`] = true;
    window.gtag?.('consent', 'update', { analytics_storage: 'denied' });
    clearAnalyticsCookies();
  };

  const loadAnalytics = () => {
    if (!analyticsEnabled || analyticsLoaded) return;
    analyticsLoaded = true;
    window[`ga-disable-${measurementId}`] = false;
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag(){ window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', measurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });
    const script = document.createElement('script');
    script.async = true;
    script.dataset.pkmAnalytics = measurementId;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    document.head.appendChild(script);
  };

  window.pkmTrack = (eventName, parameters = {}, options = {}) => {
    window.dispatchEvent(new CustomEvent('pkm:track', { detail: { eventName, parameters } }));
    if (!analyticsEnabled || readConsent() !== 'granted') return Promise.resolve(false);
    loadAnalytics();
    const timeoutMs = options.timeoutMs ?? 900;
    return new Promise((resolve) => {
      let finished = false;
      const finish = (sent) => {
        if (finished) return;
        finished = true;
        resolve(sent);
      };
      window.gtag?.('event', eventName, {
        ...parameters,
        event_callback: () => finish(true),
        event_timeout: timeoutMs,
      });
      window.setTimeout(() => finish(false), timeoutMs);
    });
  };

  const syncConsentUi = (value) => {
    if (consentBox instanceof HTMLElement) consentBox.hidden = Boolean(value);
    if (settingsButton instanceof HTMLElement) settingsButton.hidden = !value;
  };

  const setConsent = (value) => {
    const previous = readConsent();
    writeConsent(value);
    if (value === 'granted') loadAnalytics();
    else disableAnalytics();
    syncConsentUi(value);
    if (previous === 'granted' && value === 'denied') window.location.reload();
  };

  const currentConsent = readConsent();
  if (currentConsent === 'granted') loadAnalytics();
  syncConsentUi(currentConsent);

  consentBox?.querySelectorAll('[data-consent]').forEach((button) => {
    button.addEventListener('click', () => setConsent(button.getAttribute('data-consent') || 'denied'));
  });

  settingsButton?.addEventListener('click', () => {
    if (consentBox instanceof HTMLElement) consentBox.hidden = false;
    if (settingsButton instanceof HTMLElement) settingsButton.hidden = true;
  });

  const getCtaLocation = (target) => {
    if (target.dataset.trackLocation) return target.dataset.trackLocation;
    if (target.closest('header')) return 'header';
    if (target.closest('.dock')) return 'dock';
    if (target.closest('footer')) return 'footer';
    const section = target.closest('main section');
    return section?.id || 'content';
  };

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('a') : null;
    if (!(target instanceof HTMLAnchorElement) || target.hasAttribute('download')) return;
    const href = target.href;
    const path = target.pathname;
    let eventName = '';
    const parameters = {
      page_language: document.documentElement.lang || 'en',
      cta_location: getCtaLocation(target),
      link_text: (target.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 100),
    };
    if (href.includes('wa.me/')) eventName = 'whatsapp_click';
    else if (href.startsWith('tel:')) eventName = 'phone_click';
    else if (href.startsWith('mailto:')) eventName = 'email_click';
    else if (/\/(reserver|book|buchen)\//.test(path)) {
      eventName = 'booking_click';
      parameters.destination_path = path;
    } else if (/\/(tarifs|prices|preise)\//.test(path)) {
      eventName = 'pricing_click';
      parameters.destination_path = path;
    } else if (target.origin !== window.location.origin) {
      eventName = 'outbound_click';
      parameters.destination_host = target.hostname;
    }
    if (!eventName) return;

    const tracking = window.pkmTrack(eventName, parameters);
    const isPlainPrimaryClick = event instanceof MouseEvent
      && event.button === 0
      && !event.metaKey
      && !event.ctrlKey
      && !event.shiftKey
      && !event.altKey;
    const opensSameContext = !target.target || target.target === '_self';
    if (isPlainPrimaryClick && opensSameContext) {
      event.preventDefault();
      Promise.resolve(tracking).finally(() => window.location.assign(href));
    }
  });
</script>
