---
import Button from './Button.astro';

/*
  Barre basse fixe — les deux CTA de conversion doivent rester visibles partout.
  waHref : lien wa.me/... complet (avec message pré-rempli si possible).
*/
const { tarifsHref, waHref, tarifsLabel = 'Tarifs', waLabel = 'Réserver' } = Astro.props;
---
<div class="dock">
  <Button variant="ghost" href={tarifsHref}>{tarifsLabel}</Button>
  <Button variant="wa" href={waHref}>{waLabel}</Button>
</div>

<style>
  .dock {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 45;
    background: rgba(255,255,255,.94); backdrop-filter: blur(12px);
    border-top: 1px solid var(--line);
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    display: flex; gap: 9px;
  }
  .dock :global(.btn) { flex: 1; font-size: .95rem; padding: 13px 12px; }

  @media (min-width: 900px) {
    .dock {
      left: auto;
      right: 24px;
      bottom: 24px;
      width: 340px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 22px;
      box-shadow: 0 12px 36px rgba(10, 44, 48, .18);
    }
  }
</style>
