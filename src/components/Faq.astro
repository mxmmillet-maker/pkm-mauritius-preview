---
/*
  Accordéon FAQ. Structure HTML native <details>/<summary> — volontairement,
  car elle correspond exactement au schema FAQPage attendu par Google et les
  LLM (voir brief design §3). Ne pas remplacer par un composant JS custom.

  items : [{ question, answer }]
  Le schema FAQPage correspondant doit être généré séparément dans la page
  avec lib/schema.js → faqPage(items) et passé à <Layout jsonLd={[...]}>.
*/
const { items = [] } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.question}</summary>
      <p>{item.answer}</p>
    </details>
  ))}
</div>

<style>
  details { border-bottom: 1px solid var(--line); }
  summary {
    font-family: var(--font-display); font-weight: 600; font-size: .99rem;
    padding: 15px 28px 15px 0; cursor: pointer; list-style: none; position: relative;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+"; position: absolute; right: 2px; top: 13px;
    font-size: 1.3rem; color: var(--sage-deep); font-weight: 400;
  }
  details[open] summary::after { content: "–"; }
  details p { font-size: .93rem; color: var(--ink-soft); padding-bottom: 14px; margin: 0; }
</style>
