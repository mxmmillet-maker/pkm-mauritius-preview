---
import Layout from '../../../layouts/Layout.astro';
import { breadcrumbList } from '../../../lib/schema';
import site from '../../../data/site.json';

const translations = { fr: '/fr/guide/', en: '/en/guide/', de: '/de/guide/' };

const guides = [
  { title: 'Beste Reisezeit zum Kitesurfen auf Mauritius', desc: 'Wind und Bedingungen Monat für Monat.', href: '/de/guide/beste-reisezeit-kitesurfen-mauritius/' },
  { title: 'Der Kitespot Le Morne', desc: 'Lagune, Riff, Tide und Zonen nach Level.', href: '/de/kitesurfen-le-morne/' },
  { title: 'Wie lange dauert es, Kitesurfen zu lernen?', desc: 'Der Fortschritt Tag für Tag.', href: '/de/guide/wie-lange-kitesurfen-lernen/' },
  { title: 'Wie viel kostet Kitesurfen?', desc: 'Realistische Preisspannen am Markt.', href: '/de/guide/kosten-kitesurfen-mauritius/' },
  { title: 'FAQ', desc: 'Alles, was uns vor der Buchung gefragt wird.', href: '/de/faq/' },
];
---
<Layout
  title="Kitesurf-Guides für Mauritius — PKM"
  description="Wind nach Monaten, der Spot Le Morne, Lerndauer und Budget: praktische Guides für deine Kitesurfreise nach Mauritius."
  locale="de"
  translations={translations}
  tarifsHref="/de/preise/"
  waHref="/de/buchen/"
  jsonLd={[breadcrumbList([
    { name: 'Startseite', url: `${site.url}/de/` },
    { name: 'Guides', url: `${site.url}/de/guide/` },
  ])]}
>
  <section class="pad">
    <span class="kicker">Guides</span>
    <h1>Alles für die Planung deiner Kitesurfreise</h1>
  </section>
  <section class="pad">
    <div class="picker">
      {guides.map((g) => (
        <a class="pick" href={g.href}>
          <div class="t"><b>{g.title}</b><small>{g.desc}</small></div>
          <span class="ar">→</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .picker { display: grid; gap: 10px; }
  .pick {
    display: flex; align-items: center; gap: 13px; padding: 15px;
    border: 1px solid var(--line); border-radius: 15px; background: #fff;
    text-decoration: none; color: var(--ink); box-shadow: var(--shadow);
  }
  .pick .t { flex: 1; }
  .pick .t b { font-family: var(--font-display); font-weight: 500; font-size: 1rem; display: block; }
  .pick .t small { color: var(--ink-soft); font-size: .83rem; }
  .pick .ar { color: var(--sage-deep); font-size: 1.2rem; }
</style>
