---
import Layout from '../../../../layouts/Layout.astro';
import Faq from '../../../../components/Faq.astro';
import Button from '../../../../components/Button.astro';
import { faqPage, breadcrumbList } from '../../../../lib/schema';
import site from '../../../../data/site.json';

const translations = {
  fr: '/fr/guide/budget-kitesurf-ile-maurice/',
  en: '/en/guide/kitesurfing-mauritius-cost/',
  de: '/de/guide/kosten-kitesurfen-mauritius/',
};

const faqItems = [
  {
    question: 'Wie viel kostet ein Kitesurfkurs auf Mauritius?',
    answer: 'In Le Morne liegen semi-private Kurse für zwei Schüler meist zwischen 1.900 und 3.000 Rs pro Stunde und Person. Privatunterricht mit einem Lehrer für einen Schüler kostet ungefähr 3.800 bis 5.000 Rs pro Stunde.',
  },
  {
    question: 'Welches Preis-Leistungs-Verhältnis bietet PKM?',
    answer: 'PKM liegt im wettbewerbsfähigen Teil der beobachteten Spannen. Eine zweistündige Einheit kostet 4.000 Rs pro Stunde privat und 2.250 Rs pro Stunde und Person semi-privat. Pakete senken den Stundenpreis weiter.',
  },
  {
    question: 'Was sollte ich vor der Wahl einer Schule vergleichen?',
    answer: 'Vergleiche die tatsächliche Unterrichtsdauer, das Verhältnis von Schülern zu Lehrern, das enthaltene Material, das Sicherheitsboot, die Regelung bei fehlendem Wind und den gesamten Paketumfang.',
  },
];
---
<Layout
  title="Was kostet Kitesurfen auf Mauritius? | PKM"
  description="Stündliche Preisspannen für Kitesurfkurse in Le Morne sowie Tipps zum Vergleich von Betreuung, Material und Sicherheit."
  locale="de"
  translations={translations}
  tarifsHref="/de/preise/"
  waHref="/de/buchen/"
  jsonLd={[
    faqPage(faqItems),
    breadcrumbList([
      { name: 'Startseite', url: `${site.url}/de/` },
      { name: 'Guides', url: `${site.url}/de/guide/` },
      { name: 'Kosten', url: `${site.url}/de/guide/kosten-kitesurfen-mauritius/` },
    ]),
  ]}
>
  <section class="pad">
    <span class="kicker">Guide</span>
    <h1>Wie viel kostet Kitesurfen auf Mauritius?</h1>
    <p class="sub">In Le Morne zahlst du für semi-private Kurse meist <b>1.900 bis 3.000 Rs pro Stunde und Person</b>. Privatunterricht kostet ungefähr <b>3.800 bis 5.000 Rs pro Stunde</b>. Für einen fairen Vergleich zählen vor allem die Betreuungsquote und die enthaltenen Leistungen.</p>
  </section>

  <section class="pad">
    <h2>Stündliche Preisspannen in Le Morne</h2>
    <p><b>Semi-privat, 2 Schüler:</b> ungefähr 1.900 bis 3.000 Rs pro Stunde und Person.</p>
    <p><b>Privat, 1 Lehrer für 1 Schüler:</b> ungefähr 3.800 bis 5.000 Rs pro Stunde.</p>
    <p><b>Pakete mit mehreren Einheiten:</b> ab 6 gebuchten Stunden sinkt der Stundenpreis in der Regel.</p>
    <p class="sub">Diese Richtwerte basieren auf öffentlich verfügbaren Preislisten für Le Morne. Saison, Gruppengröße, Material und enthaltene Leistungen können den Endpreis verändern.</p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>Wo PKM liegt</h2>
    <p>Eine zweistündige Einheit kostet <b>4.000 Rs pro Stunde privat</b> und <b>2.250 Rs pro Stunde und Person semi-privat</b>. Beim 10-Stunden-Paket sinkt der Preis auf 3.800 Rs pro Stunde privat und 1.925 Rs pro Stunde und Person semi-privat.</p>
    <p class="sub" style="font-size:.9rem">Material inklusive. Aktuelle Details und Pakete findest du auf der Preisseite.</p>
  </section>

  <section class="pad">
    <h2>Was im Kurspreis steckt</h2>
    <p><b>Enge Betreuung:</b> höchstens 2 Schüler pro Lehrer, im semi-privaten Kurs mit einem Kite und einem Board für jede Person.</p>
    <p><b>Sicherheit am Spot:</b> Helm und Prallschutzweste, je nach Programm und Bedingungen ein verfügbares Sicherheitsboot sowie VHF-Funk bei geeigneten Lernformaten.</p>
    <p><b>Planbare Buchung:</b> fehlt der Wind, wird die Einheit ohne zusätzliche Kosten verschoben.</p>
  </section>

  <section class="pad" style="text-align:center">
    <Button variant="primary" href="/de/preise/">PKM-Preise ansehen</Button>
  </section>

  <section class="pad">
    <h2>Häufige Fragen</h2>
    <Faq items={faqItems} />
  </section>
</Layout>
