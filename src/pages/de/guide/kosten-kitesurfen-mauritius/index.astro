---
import Layout from '../../../../layouts/Layout.astro';
import Faq from '../../../../components/Faq.astro';
import Button from '../../../../components/Button.astro';
import { faqPage, breadcrumbList } from '../../../../lib/schema';
import site from '../../../../data/site.json';

const translations = {
  fr: '/fr/guide/budget-kitesurf-ile-maurice/',
  en: '/en/guide/kitesurfing-mauritius-cost/',
  de: '/de/guide/kosten-kitesurfen-mauritius/',
};

const faqItems = [
  {
    question: 'Wie viel kostet ein Kitesurfkurs auf Mauritius?',
    answer: 'Bei PKM kostet ein zweistündiger Privatkurs 8.000 Rs. Semi-privat zu zweit kostet ein zweistündiger Kurs 4.500 Rs pro Person. Vergleiche bei anderen Schulen immer dieselbe Dauer und dieselbe Anzahl von Schülern pro Lehrer.',
  },
  {
    question: 'Ist PKM teurer als andere Schulen in Le Morne?',
    answer: 'PKM liegt in einem wettbewerbsfähigen Preisbereich. Born to Kite ist je nach Paket meist etwas günstiger, LMKS etwas teurer und ION CLUB deutlich teurer.',
  },
  {
    question: 'Was sollte ich vor der Wahl einer Schule vergleichen?',
    answer: 'Vergleiche die tatsächliche Unterrichtsdauer, das Verhältnis von Schülern zu Lehrern, das enthaltene Material, das Sicherheitsboot, die Regelung bei fehlendem Wind und den gesamten Paketumfang.',
  },
];
---
<Layout
  title="Was kostet Kitesurfen auf Mauritius? | PKM"
  description="Vergleiche die Preise der Kiteschulen in Le Morne bei gleicher Dauer und Betreuung. Position von PKM gegenüber Born to Kite, LMKS und ION CLUB."
  locale="de"
  translations={translations}
  tarifsHref="/de/preise/"
  waHref="/de/buchen/"
  jsonLd={[
    faqPage(faqItems),
    breadcrumbList([
      { name: 'Startseite', url: `${site.url}/de/` },
      { name: 'Guides', url: `${site.url}/de/guide/` },
      { name: 'Kosten', url: `${site.url}/de/guide/kosten-kitesurfen-mauritius/` },
    ]),
  ]}
>
  <section class="pad">
    <span class="kicker">Guide</span>
    <h1>Wie viel kostet Kitesurfen auf Mauritius?</h1>
    <p class="sub">PKM liegt in Le Morne in einem wettbewerbsfähigen Preisbereich. Bei vergleichbaren Angeboten ist Born to Kite meist etwas günstiger, LMKS etwas teurer und ION CLUB deutlich teurer.</p>
  </section>

  <section class="pad">
    <h2>Die richtige Preisreihenfolge in Le Morne</h2>
    <p><b>Born to Kite:</b> je nach Dauer und Paket meist etwas günstiger als PKM.</p>
    <p><b>Paradise Kitesurfing Mauritius:</b> der Vergleichspunkt, mit 8.000 Rs für 2 Stunden Privatunterricht und 4.500 Rs pro Person für 2 Stunden semi-privat zu zweit.</p>
    <p><b>LMKS:</b> bei Privatkursen und mehreren vergleichbaren Paketen etwas teurer als PKM.</p>
    <p><b>ION CLUB:</b> deutlich teurer als PKM und als internationales Wassersportzentrum positioniert.</p>
    <p class="sub">Preislisten ändern sich von Saison zu Saison. Diese Reihenfolge zeigt die relative Position der Schulen, ohne Kurse mit unterschiedlicher Dauer oder Betreuung zu einem künstlichen Durchschnitt zusammenzufassen.</p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>Der PKM-Vergleichspunkt</h2>
    <p>Bei Paradise Kitesurfing Mauritius betreut im Privatkurs 1 Lehrer 1 Schüler für 2 Stunden zum Preis von 8.000 Rs. Semi-privat betreut 1 Lehrer 2 Schüler für 2 Stunden zum Preis von 4.500 Rs pro Person. Die Pakete mit 6, 8 und 10 Stunden senken anschließend den Stundenpreis.</p>
    <p class="sub" style="font-size:.9rem">Material inklusive. Aktuelle Details und Pakete findest du auf der Preisseite.</p>
  </section>

  <section class="pad">
    <h2>So vergleichst du die Preise richtig</h2>
    <p><b>Gleiche Dauer:</b> Vergleiche einen zweistündigen Kurs mit einem anderen zweistündigen Kurs oder ein 6-Stunden-Paket mit einem anderen 6-Stunden-Paket.</p>
    <p><b>Gleiche Betreuung:</b> Ein Privatkurs im Verhältnis 1 zu 1 lässt sich nicht mit dem Preis pro Person in einer Gruppe von 3 oder 4 Schülern vergleichen.</p>
    <p><b>Gleiche Leistungen:</b> Prüfe Material, Versicherung, Sicherheitsboot, möglichen Transport und die Regelung bei fehlendem Wind.</p>
  </section>

  <section class="pad" style="text-align:center">
    <Button variant="primary" href="/de/preise/">PKM-Preise ansehen</Button>
  </section>

  <section class="pad">
    <h2>Häufige Fragen</h2>
    <Faq items={faqItems} />
  </section>
</Layout>
