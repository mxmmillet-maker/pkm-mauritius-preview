---
import Layout from '../../../../layouts/Layout.astro';
import Faq from '../../../../components/Faq.astro';
import Button from '../../../../components/Button.astro';
import { faqPage, breadcrumbList } from '../../../../lib/schema';
import site from '../../../../data/site.json';

const translations = {
  fr: '/fr/guide/budget-kitesurf-ile-maurice/',
  en: '/en/guide/kitesurfing-mauritius-cost/',
  de: '/de/guide/kosten-kitesurfen-mauritius/',
};

const faqItems = [
  {
    question: 'How much does a kitesurfing lesson cost in Mauritius?',
    answer: 'At PKM, a 2-hour private lesson costs Rs 8,000. A 2-hour semi-private lesson for two costs Rs 4,500 per person. When comparing schools, always check the same duration and the same number of students per instructor.',
  },
  {
    question: 'Is PKM more expensive than other Le Morne schools?',
    answer: 'PKM sits in a competitive price range. Born to Kite is generally a little cheaper depending on the package, LMKS a little more expensive, and ION CLUB significantly more expensive.',
  },
  {
    question: 'What should I compare before choosing a school?',
    answer: 'Compare the actual lesson time, student-to-instructor ratio, included equipment, safety boat, no-wind policy and everything included in the package.',
  },
];
---
<Layout
  title="How Much Does Kitesurfing Cost in Mauritius? | PKM"
  description="Compare Le Morne kitesurfing school prices using the same duration and teaching ratio. See where PKM sits against Born to Kite, LMKS and ION CLUB."
  locale="en"
  translations={translations}
  tarifsHref="/en/prices/"
  waHref="/en/book/"
  jsonLd={[
    faqPage(faqItems),
    breadcrumbList([
      { name: 'Home', url: `${site.url}/en/` },
      { name: 'Guides', url: `${site.url}/en/guide/` },
      { name: 'Cost', url: `${site.url}/en/guide/kitesurfing-mauritius-cost/` },
    ]),
  ]}
>
  <section class="pad">
    <span class="kicker">Guide</span>
    <h1>How much does kitesurfing cost in Mauritius?</h1>
    <p class="sub">
      PKM sits in a competitive price range at Le Morne. For comparable
      packages, Born to Kite is generally a little cheaper, LMKS a little more
      expensive, and ION CLUB significantly more expensive.
    </p>
  </section>

  <section class="pad">
    <h2>The right price order at Le Morne</h2>
    <p><b>Born to Kite:</b> generally a little cheaper than PKM, depending on the lesson length and package.</p>
    <p><b>Paradise Kitesurfing Mauritius:</b> the reference point, with a 2-hour private lesson at Rs 8,000 and a 2-hour semi-private lesson for two at Rs 4,500 per person.</p>
    <p><b>LMKS:</b> slightly more expensive than PKM for private lessons and several comparable packages.</p>
    <p><b>ION CLUB:</b> significantly more expensive than PKM, with the positioning of an international watersports centre.</p>
    <p class="sub">
      Price lists change from one season to the next. This order shows the
      relative positioning of the schools without averaging lessons that have
      different durations or teaching ratios.
    </p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>The PKM reference point</h2>
    <p>
      At Paradise Kitesurfing Mauritius, a private lesson pairs 1 instructor
      with 1 student for 2 hours at Rs 8,000. A semi-private lesson pairs 1
      instructor with 2 students for 2 hours at Rs 4,500 per person. The 6, 8
      and 10-hour packages then reduce the hourly rate.
    </p>
    <p class="sub" style="font-size:.9rem">Equipment included. Current details and packages are available on the prices page.</p>
  </section>

  <section class="pad">
    <h2>How to make a fair comparison</h2>
    <p><b>Same duration:</b> compare a 2-hour lesson with another 2-hour lesson, or a 6-hour package with another 6-hour package.</p>
    <p><b>Same teaching ratio:</b> a 1-to-1 private lesson cannot be compared with the per-person price of a group of 3 or 4.</p>
    <p><b>Same services:</b> check the equipment, insurance, safety boat, any transport and the policy when the wind does not cooperate.</p>
  </section>

  <section class="pad" style="text-align:center">
    <Button variant="primary" href="/en/prices/">See PKM prices</Button>
  </section>

  <section class="pad">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} />
  </section>
</Layout>
