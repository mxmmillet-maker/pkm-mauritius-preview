---
import Layout from '../../../../layouts/Layout.astro';
import Faq from '../../../../components/Faq.astro';
import Button from '../../../../components/Button.astro';
import { faqPage, breadcrumbList } from '../../../../lib/schema';
import site from '../../../../data/site.json';

const translations = {
  fr: '/fr/guide/budget-kitesurf-ile-maurice/',
  en: '/en/guide/kitesurfing-mauritius-cost/',
  de: '/de/guide/kosten-kitesurfen-mauritius/',
};

const faqItems = [
  {
    question: 'How much does a kitesurfing lesson cost in Mauritius?',
    answer: 'Across Mauritius, publicly available price lists generally range from Rs 1,900 to Rs 3,400 per hour and per person for a small group or semi-private lesson, around €38 to €68. Private lessons usually cost Rs 3,500 to Rs 6,500 per hour, around €70 to €130.',
  },
  {
    question: 'What value does PKM offer?',
    answer: 'PKM sits within the average price range observed in Mauritius. A 2-hour session works out at Rs 4,000 per hour privately, around €80, and Rs 2,250 per hour and per person semi-privately, around €45. Recent equipment, certified instruction and safety gear are included.',
  },
  {
    question: 'What should I compare before choosing a school?',
    answer: 'Compare the actual lesson time, student-to-instructor ratio, included equipment, safety boat, no-wind policy and everything included in the package.',
  },
  {
    question: 'Are prices shown in Mauritian rupees or euros?',
    answer: 'The currency used in Mauritius is the Mauritian rupee. PKM displays its rates in rupees with an indicative euro equivalent based on a simple reference of Rs 50 for €1. Your bank’s converted amount may vary.',
  },
];
---
<Layout
  title="How Much Does Kitesurfing Cost in Mauritius? | PKM"
  description="Kitesurfing lesson prices in Mauritius in rupees and euros. Hourly ranges, PKM rates, certified instruction, equipment and safety."
  locale="en"
  translations={translations}
  tarifsHref="/en/prices/"
  waHref="/en/book/"
  jsonLd={[
    faqPage(faqItems),
    breadcrumbList([
      { name: 'Home', url: `${site.url}/en/` },
      { name: 'Guides', url: `${site.url}/en/guide/` },
      { name: 'Cost', url: `${site.url}/en/guide/kitesurfing-mauritius-cost/` },
    ]),
  ]}
>
  <section class="pad">
    <span class="kicker">Guide</span>
    <h1>How much does kitesurfing cost in Mauritius?</h1>
    <p class="sub">
      Across Mauritius, expect around <b>Rs 1,900 to Rs 3,400 per hour and per
      person for a small group or semi-private lesson (approximately €38 to
      €68)</b>, and <b>Rs 3,500 to Rs 6,500 per hour privately (approximately
      €70 to €130)</b>. The teaching ratio and included services explain much
      of the difference.
    </p>
  </section>

  <section class="pad">
    <h2>Price benchmarks across Mauritius</h2>
    <div class="proofs">
      <div class="proof">
        <b>Small group or semi-private</b>
        <span>Rs 1,900 to Rs 3,400 per hour and per person, approximately €38 to €68.</span>
      </div>
      <div class="proof">
        <b>Private lesson, 1 to 1</b>
        <span>Rs 3,500 to Rs 6,500 per hour, approximately €70 to €130.</span>
      </div>
      <div class="proof">
        <b>6 to 10-hour packages</b>
        <span>The hourly price generally falls when several sessions are booked together.</span>
      </div>
    </div>
    <p class="sub">
      These benchmarks are calculated from public price lists available across
      Mauritius. They remain indicative. Euro equivalents are rounded using
      PKM's reference of approximately €1 for Rs 50.
    </p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>How to read a price list</h2>
    <div class="proofs">
      <div class="proof">
        <b>Is the price per person?</b>
        <span>A semi-private rate is often displayed for one person even though two students take part.</span>
      </div>
      <div class="proof">
        <b>How many students share an instructor?</b>
        <span>A group of four and a private lesson offer very different practice time and feedback.</span>
      </div>
      <div class="proof">
        <b>Are equipment and safety included?</b>
        <span>Check the kite, board, helmet, impact vest, supervision and the policy when there is no wind.</span>
      </div>
    </div>
  </section>

  <section class="pad">
    <h2>Where PKM sits</h2>
    <p>
      PKM sits <b>within the average price range observed in Mauritius</b>, with
      recent equipment, certified instructors and no more than two students per
      instructor. A 2-hour session works out at Rs 4,000 per hour privately
      (approximately €80) and Rs 2,250 per hour and per person semi-privately
      (approximately €45).
    </p>
    <div class="proofs">
      <div class="proof">
        <b>Private, 2 hours</b>
        <span>Rs 8,000, approximately €160. One instructor for one student.</span>
      </div>
      <div class="proof">
        <b>Semi-private, 2 hours</b>
        <span>Rs 4,500 per person, approximately €90. Two students maximum.</span>
      </div>
      <div class="proof">
        <b>10-hour package</b>
        <span>As low as Rs 3,800 per hour privately and Rs 1,925 per hour and per person semi-privately.</span>
      </div>
    </div>
    <p class="sub" style="font-size:.9rem">2026 rates. The equipment and safety gear listed for each package are included.</p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>What your lesson price covers</h2>
    <div class="proofs">
      <div class="proof">
        <b>Certified instructors</b>
        <span>A clear teaching framework for learning, rebuilding confidence or working on a specific goal.</span>
      </div>
      <div class="proof">
        <b>Recent equipment</b>
        <span>A Duotone equipment range matched to the student's level and the day's conditions.</span>
      </div>
      <div class="proof">
        <b>Close instruction</b>
        <span>No more than two students per instructor, with one kite and one board each in semi-private lessons.</span>
      </div>
      <div class="proof">
        <b>Safety on the spot</b>
        <span>Helmet and impact vest, a boat available depending on the programme and conditions, plus VHF radio on suitable formats.</span>
      </div>
      <div class="proof">
        <b>A genuine school atmosphere</b>
        <span>An approachable team and a few loungers for waiting, relaxing between sessions or watching the rest of your group.</span>
      </div>
      <div class="proof">
        <b>Free rescheduling</b>
        <span>If the wind does not cooperate, the lesson moves to another time slot at no extra cost.</span>
      </div>
    </div>
    <figure class="guide-photo">
      <img
        src="/images/pkm-equipment-wide.webp"
        alt="The open PKM truck with boards, impact vests, helmets and Duotone equipment set out in front of the base"
        width="1600"
        height="1280"
        loading="lazy"
      />
      <figcaption>The PKM truck and equipment fleet, ready for the day's sessions at Le Morne.</figcaption>
    </figure>
  </section>

  <section class="pad" style="text-align:center">
    <Button variant="primary" href="/en/prices/">See PKM prices</Button>
  </section>

  <section class="pad">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} />
  </section>
</Layout>
