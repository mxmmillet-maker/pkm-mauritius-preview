---
import Layout from '../../../../layouts/Layout.astro';
import Faq from '../../../../components/Faq.astro';
import Button from '../../../../components/Button.astro';
import { faqPage, breadcrumbList } from '../../../../lib/schema';
import site from '../../../../data/site.json';

const translations = {
  fr: '/fr/guide/budget-kitesurf-ile-maurice/',
  en: '/en/guide/kitesurfing-mauritius-cost/',
  de: '/de/guide/kosten-kitesurfen-mauritius/',
};

const faqItems = [
  {
    question: 'How much does a kitesurfing lesson cost in Mauritius?',
    answer: 'At Le Morne, semi-private lessons for two generally range from Rs 1,900 to Rs 3,000 per hour and per person. A private lesson with one instructor for one student is usually around Rs 3,800 to Rs 5,000 per hour.',
  },
  {
    question: 'What value does PKM offer?',
    answer: 'PKM sits in the competitive part of the observed ranges, at Rs 4,000 per hour for a private lesson and Rs 2,250 per hour and per person for a 2-hour semi-private lesson. Packages reduce the hourly price further.',
  },
  {
    question: 'What should I compare before choosing a school?',
    answer: 'Compare the actual lesson time, student-to-instructor ratio, included equipment, safety boat, no-wind policy and everything included in the package.',
  },
];
---
<Layout
  title="How Much Does Kitesurfing Cost in Mauritius? | PKM"
  description="Hourly kitesurfing lesson price ranges at Le Morne, with advice on comparing teaching ratios, equipment and safety services."
  locale="en"
  translations={translations}
  tarifsHref="/en/prices/"
  waHref="/en/book/"
  jsonLd={[
    faqPage(faqItems),
    breadcrumbList([
      { name: 'Home', url: `${site.url}/en/` },
      { name: 'Guides', url: `${site.url}/en/guide/` },
      { name: 'Cost', url: `${site.url}/en/guide/kitesurfing-mauritius-cost/` },
    ]),
  ]}
>
  <section class="pad">
    <span class="kicker">Guide</span>
    <h1>How much does kitesurfing cost in Mauritius?</h1>
    <p class="sub">
      At Le Morne, expect around <b>Rs 1,900 to Rs 3,000 per hour and per
      person for semi-private lessons</b>, and <b>Rs 3,800 to Rs 5,000 per hour
      for private lessons</b>. A fair comparison starts with the teaching ratio
      and the services actually included.
    </p>
  </section>

  <section class="pad">
    <h2>Hourly price ranges at Le Morne</h2>
    <p><b>Semi-private, 2 students:</b> approximately Rs 1,900 to Rs 3,000 per hour and per person.</p>
    <p><b>Private, 1 instructor for 1 student:</b> approximately Rs 3,800 to Rs 5,000 per hour.</p>
    <p><b>Multi-session packages:</b> the hourly price generally drops from 6 booked hours.</p>
    <p class="sub">
      These benchmarks are calculated from public price lists available for Le
      Morne. They remain indicative because season, group size, equipment and
      included services can change the final price.
    </p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>Where PKM sits</h2>
    <p>
      A 2-hour session works out at <b>Rs 4,000 per hour for a private lesson</b>
      and <b>Rs 2,250 per hour and per person for a semi-private lesson</b>. On
      the 10-hour package, the price falls to Rs 3,800 per hour privately and
      Rs 1,925 per hour and per person semi-privately.
    </p>
    <p class="sub" style="font-size:.9rem">Equipment included. Current details and packages are available on the prices page.</p>
  </section>

  <section class="pad">
    <h2>What your lesson price covers</h2>
    <p><b>Close instruction:</b> no more than 2 students per instructor, with one kite and one board each in semi-private lessons.</p>
    <p><b>Safety on the spot:</b> helmet and impact vest, a boat available depending on the programme and conditions, plus VHF radio on suitable learning formats.</p>
    <p><b>A safer booking:</b> if the wind does not cooperate, the lesson is rescheduled at no extra cost.</p>
  </section>

  <section class="pad" style="text-align:center">
    <Button variant="primary" href="/en/prices/">See PKM prices</Button>
  </section>

  <section class="pad">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} />
  </section>
</Layout>
