---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import PriceFrom from '../../components/PriceFrom.astro';
import ProfileSlider from '../../components/ProfileSlider.astro';
import Faq from '../../components/Faq.astro';
import SectionNav from '../../components/SectionNav.astro';
import { sportsActivityLocation, faqPage, breadcrumbList } from '../../lib/schema';
import site from '../../data/site.json';

const translations = { fr: '/fr/', en: '/en/' };
const waPhone = site.phones[0].replace(/\D/g, '');
const waLink = `https://wa.me/${waPhone}?text=${encodeURIComponent("Hello PKM team, I'd like to organise sessions at Le Morne.")}`;
const googleReviewsUrl = 'https://www.google.com/maps/search/?api=1&query=Paradise+Kitesurfing+Mauritius+Le+Morne';
const sectionNav = [
  { label: 'Your pathway', href: '#pathway' },
  { label: 'The spot', href: '#spot' },
  { label: 'Coaching', href: '#coaching' },
  { label: 'Prices', href: '#prices' },
  { label: 'The team', href: '#team' },
  { label: 'Reviews', href: '#reviews' },
];

const profiles = [
  {
    eyebrow: 'First time', title: "I'm a beginner",
    text: 'Learn to fly the kite, waterstart and work towards supervised riding on the lagoon.',
    href: '/en/kitesurf-lessons/', image: '/images/pkm-beginner-lesson.webp',
    alt: 'A student learning to control her kite in the lagoon with a PKM instructor', linkLabel: 'See beginner lessons',
  },
  {
    eyebrow: 'Comeback', title: 'I want my confidence back',
    text: 'A return-to-water session built around your level, without making you start from scratch.',
    href: '/en/kitesurf-lessons/#comeback', image: '/images/pkm-confidence-lesson.webp',
    alt: 'A kitesurfer rebuilding confidence in front of Le Morne mountain', linkLabel: 'Plan my comeback',
  },
  {
    eyebrow: 'Freestyle', title: 'I want to move up a level',
    text: 'Upwind riding, toeside, transitions, first jumps or rotations according to your goal.',
    href: '/en/wave-freestyle-coaching/#freestyle', image: '/images/pkm-freestyle-morne.webp',
    alt: 'A kitesurfer jumping in front of Le Morne mountain', linkLabel: 'Explore freestyle coaching',
  },
  {
    eyebrow: 'Waves', title: 'I want to ride waves',
    text: 'Positioning, jibes, wave reading and progressive independence from Small Reef to Manawa.',
    href: '/en/wave-freestyle-coaching/#waves', image: '/images/pkm-action-morne.webp',
    alt: 'A kitesurfer carving dynamically through chop at Le Morne', linkLabel: 'See the wave pathway',
  },
  {
    eyebrow: 'Wingfoil', title: 'I want to try wingfoiling',
    text: 'A first session, first flights or foil progression, in a private or semi-private format.',
    href: '/en/prices/#wingfoil', image: '/images/pkm-wingfoil.webp',
    alt: 'A PKM wingfoiler gliding across Le Morne lagoon', linkLabel: 'See wingfoil sessions',
  },
];

const faqItems = [
  {
    question: 'Can we come with different levels?',
    answer: 'Yes. A family or couple can build one programme with different sessions: beginner lagoon lessons, a confidence refresher, freestyle coaching or wave guidance. A 10% reduction applies from three people booked together.',
  },
  {
    question: 'What happens if there is no wind?',
    answer: 'The session is moved to another slot at no cost. The programme is adjusted to the weather during your stay.',
  },
  {
    question: 'How much is a kitesurfing lesson at Le Morne?',
    answer: 'A 2-hour semi-private lesson is Rs 4,500 per person and a private lesson is Rs 8,000. The gear and safety equipment specified for the package are included.',
  },
  {
    question: 'How do I book?',
    answer: 'Send your dates, level and group size. The team replies on WhatsApp with a suggested programme and available slots. A 10% deposit then confirms the booking.',
  },
];
---

<Layout
  title="Kitesurfing School in Le Morne, Mauritius | Paradise Kitesurfing Mauritius"
  description="Beginner lessons, comeback sessions, freestyle, wave coaching and wingfoiling at Le Morne. Programmes for families and mixed levels."
  locale="en"
  translations={translations}
  tarifsHref="/en/prices/"
  waHref="/en/book/"
  jsonLd={[
    sportsActivityLocation(),
    faqPage(faqItems),
    breadcrumbList([{ name: 'Home', url: `${site.url}/en/` }]),
  ]}
>
  <section class="hero-photo pad">
    <span class="hero-photo__media">
      <img class="hero-photo__mobile" src="/images/pkm-hero-mobile.webp" alt="Kitesurfer jumping across Le Morne lagoon" width="900" height="1600" fetchpriority="high" />
      <img class="hero-photo__desktop" src="/images/pkm-hero-desktop.webp" alt="Kitesurfer jumping across Le Morne lagoon" width="1920" height="1277" fetchpriority="high" />
    </span>
    <span class="hero-photo__shade" aria-hidden="true"></span>
    <div class="hero-photo__copy">
      <span class="kicker">Le Morne, Mauritius</span>
      <h1>From your first waterstart to the waves of Le Morne</h1>
      <p>Beginner, returning rider or already independent, the team builds a programme with you around your level and the day's conditions.</p>
      <div class="hero-actions">
        <Button variant="wa" href={waLink}>Talk on WhatsApp</Button>
        <Button variant="line" href="/en/kitesurf-lessons/">Explore the lessons</Button>
      </div>
      <small class="hero-photo__credit">PKM photos · Le Morne</small>
    </div>
  </section>

  <section class="trust-strip pad" aria-label="Trust markers">
    <a class="trust-card trust-card--google" href={googleReviewsUrl} target="_blank" rel="noreferrer">
      <span class="trust-brand"><img src="/images/google-g.svg" alt="" width="24" height="24" /><strong>Google</strong></span>
      <span class="trust-score"><b>{site.googleReviews.rating.toFixed(1)}</b><span class="stars" aria-label="5 stars">★★★★★</span></span>
      <small>{site.googleReviews.count} public reviews</small>
      <span class="trust-link">Read the reviews →</span>
    </a>
    <a class="trust-card trust-card--tripadvisor" href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">
      <span class="trust-brand"><img src="/images/tripadvisor.svg" alt="" width="28" height="28" /><strong>TripAdvisor</strong></span>
      <span class="trust-score"><b>{site.tripAdvisorReviews.rating.toFixed(1)}</b><span class="stars" aria-label="5 stars">★★★★★</span></span>
      <small>{site.tripAdvisorReviews.count} public reviews</small>
      <span class="trust-link">Read the reviews →</span>
    </a>
    <a class="trust-card trust-card--deal" href="/en/book/">
      <span class="deal-badge">10% off</span>
      <strong>Family & group offer</strong>
      <small>From 3 people booked together</small>
      <span class="trust-link">Build the trip →</span>
    </a>
  </section>

  <SectionNav items={sectionNav} label="Quick access to page sections" />

  <section class="pad profile-section" id="pathway">
    <span class="kicker">Your programme</span>
    <h2>What do you want to do on the water?</h2>
    <p class="sub">Swipe through the cards. Each person can follow their own pathway, even when you come as a family or couple.</p>
    <ProfileSlider items={profiles} label="Choose a pathway based on your level" />
  </section>

  <section class="pad spot-section" id="spot">
    <div>
      <span class="kicker">The spot</span>
      <h2>The lagoon is a proper progression playground</h2>
      <p class="sub">There is very flat water for working on a move, chop for trying first jumps and enough space to move away from other lessons. The sandy bottom and standing areas make learning more comfortable.</p>
    </div>
    <div class="windbox">
      <h3>When to come</h3>
      <div class="wgrid">
        <div class="peak"><b>June → September</b><small>18 to 35 knots · main season</small></div>
        <div><b>April, May, Oct., Nov.</b><small>10 to 25 knots · warmer</small></div>
        <div><b>Dec. → March</b><small>10 to 25 knots · fewer windy days</small></div>
        <div><b>Year-round</b><small>Water between 22 and 28°C</small></div>
      </div>
      <p class="data-note">Seasonal guidance, not a weather promise: slots are adjusted to the actual forecast during your stay.</p>
    </div>
    <figure class="spot-aerial">
      <img src="/images/pkm-le-morne-aerial.webp" alt="Aerial view of Le Morne Brabant, its lagoon and the coral reef" width="1920" height="1280" loading="lazy" />
      <figcaption>Le Morne Brabant, the lagoon and the coral reef · Unsplash photo</figcaption>
    </figure>
  </section>

  <section class="pad progression-section" id="coaching">
    <span class="kicker">Coaching</span>
    <h2>Progress in freestyle or wave riding</h2>
    <p class="sub">Two different pathways, with a starting point chosen after assessing your current level.</p>
    <div class="track-grid">
      <article class="track-card" id="freestyle">
        <span>Freestyle · lagoon</span>
        <h3>Build control, then add amplitude</h3>
        <ol>
          <li><b>Comeback</b><small>Holding ground, upwind riding, transitions</small></li>
          <li><b>Intermediate</b><small>Toeside, pop, first jumps</small></li>
          <li><b>Advanced</b><small>Rotations and specific goals</small></li>
        </ol>
        <a href="/en/wave-freestyle-coaching/#freestyle">See freestyle coaching →</a>
      </article>
      <article class="track-card track-card--wave" id="waves">
        <span>Surf · reef</span>
        <h3>From a directional board to independence in waves</h3>
        <ol>
          <li><b>Small Reef</b><small>Jibe, positioning, first lines</small></li>
          <li><b>Chameaux and Manawa</b><small>Reading, turns, strategic zone</small></li>
          <li><b>One Eye</b><small>Only when level and conditions are suitable</small></li>
        </ol>
        <a href="/en/wave-freestyle-coaching/#waves">See the wave pathway →</a>
      </article>
    </div>
    <div class="reassure">
      <b>Just starting? The lagoon is more than enough.</b>
      <p>It offers flat water, chop, space and several working areas. You can progress all week without heading to the reef.</p>
    </div>
  </section>

  <section class="pad family-offer">
    <div>
      <span class="kicker">Families and couples</span>
      <h2>One trip, several levels</h2>
      <p>One parent can work on waves while another gets their confidence back and a younger rider starts learning. A couple can also share a session with two different goals when the format allows it.</p>
      <ul class="clean-list">
        <li>10% off from 3 people booked together</li>
        <li>A programme built around each person's level</li>
        <li>First supervised session free, offer can be combined</li>
      </ul>
      <Button variant="primary" href="/en/book/">Build our programme</Button>
    </div>
    <img src="/images/pkm-shared-stay.webp" alt="Smiling kitesurfer riding across Le Morne lagoon" width="1600" height="1200" loading="lazy" />
  </section>

  <section class="pad prices-preview" id="prices">
    <span class="kicker">Price guide</span>
    <h2>Choose a starting package</h2>
    <div class="fromgrid">
      <PriceFrom label="Lessons from" amount="4,500" currency="Rs · about €90" detail="2h semi-private, per person" />
      <PriceFrom label="Rental from" amount="2,250" currency="Rs · about €45" detail="2h, kite and board" />
    </div>
    <div class="offer-lite"><b>Sliding rental rates:</b> 2 hours, day or week. The rate falls as the duration grows.</div>
    <Button variant="ghost" href="/en/prices/">Compare all packages</Button>
  </section>

  <section class="pad school-section" id="team">
    <div class="school-intro">
      <span class="kicker">The team</span>
      <h2>Several people, from your first message to the water</h2>
      <p>On WhatsApp, with the equipment, on the lagoon and in the boat, the team works together to prepare sessions and adapt the programme to conditions.</p>
      <div class="auth">
        <div><b>Welcome</b><span>WhatsApp replies and planning</span></div>
        <div><b>Instructors</b><span>several profiles present in season</span></div>
        <div><b>Logistics</b><span>Duotone fleet, preparation and boat</span></div>
        <div><b>2 max.</b><span>students per instructor</span></div>
      </div>
    </div>
    <div class="team-gallery" aria-label="The team in action">
      <figure>
        <img src="/images/pkm-gary.webp" alt="Gary, PKM founder and instructor, on the water at Le Morne" width="900" height="1350" loading="lazy" />
        <figcaption>Gary · founder and instructor</figcaption>
      </figure>
      <figure>
        <img src="/images/pkm-equipment-wide.webp" alt="PKM school truck and equipment fleet set up at Le Morne" width="1600" height="1280" loading="lazy" />
        <figcaption>School truck and equipment fleet · PKM</figcaption>
      </figure>
    </div>
  </section>

  <section class="pad reviews-section" id="reviews">
    <span class="kicker">Reviews</span>
    <h2>Two platforms, the same recurring strengths</h2>
    <p class="sub">A few extracts from public reviews. Swipe the cards on mobile, then open the platform to read each review in full.</p>
    <div class="review-platforms">
      <article>
        <span class="platform-title"><img src="/images/google-g.svg" alt="" width="24" height="24" />Google</span>
        <h3>Google · {site.googleReviews.count} reviews</h3>
        <p>Public feedback highlights patience, safety and personal support.</p>
        <a href={googleReviewsUrl} target="_blank" rel="noreferrer">See Google reviews →</a>
      </article>
      <article>
        <span class="platform-title"><img src="/images/tripadvisor.svg" alt="" width="28" height="28" />TripAdvisor</span>
        <h3>TripAdvisor · {site.tripAdvisorReviews.count} reviews</h3>
        <p>The listing shows a score of {site.tripAdvisorReviews.rating.toFixed(1)} / 5.</p>
        <a href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">See TripAdvisor reviews →</a>
      </article>
    </div>
    <div class="review-snaps" aria-label="Customer review extracts">
      <a class="review-snap" href={googleReviewsUrl} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/google-g.svg" alt="" width="20" height="20" />Google</span><span class="stars" aria-label="5 stars">★★★★★</span></span>
        <blockquote>“I felt very safe and fully supported throughout.”</blockquote>
        <span class="review-snap__meta"><b>Nicolas O.</b><small>October 2025</small></span>
      </a>
      <a class="review-snap" href={googleReviewsUrl} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/google-g.svg" alt="" width="20" height="20" />Google</span><span class="stars" aria-label="5 stars">★★★★★</span></span>
        <blockquote>“Great teachers and amazingly patient.”</blockquote>
        <span class="review-snap__meta"><b>Neil B.</b><small>October 2025</small></span>
      </a>
      <a class="review-snap" href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/tripadvisor.svg" alt="" width="23" height="23" />TripAdvisor</span><span class="stars" aria-label="5 stars">★★★★★</span></span>
        <blockquote>“Patient, friendly, welcoming, professional and always with a big smile.”</blockquote>
        <span class="review-snap__meta"><b>Z0e2011</b><small>July 2024</small></span>
      </a>
      <a class="review-snap" href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/tripadvisor.svg" alt="" width="23" height="23" />TripAdvisor</span><span class="stars" aria-label="5 stars">★★★★★</span></span>
        <blockquote>“The staff was incredibly friendly, patient, and adaptive.”</blockquote>
        <span class="review-snap__meta"><b>Vlassis T.</b><small>October 2023</small></span>
      </a>
    </div>
  </section>

  <section class="pad faq-section">
    <span class="kicker">FAQ</span>
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} />
  </section>

  <section class="pad final-cta" id="capture">
    <span class="kicker">Nou ale?</span>
    <h2>Plan your course, coaching or individual sessions</h2>
    <p>Send your dates and the levels in your group. The team suggests a realistic programme on WhatsApp.</p>
    <div class="hero-actions">
      <Button variant="wa" href={waLink}>Talk to the team</Button>
      <Button variant="line" href="/en/book/">Describe my trip</Button>
    </div>
  </section>
</Layout>
