---
/* EN prices page — mirrors src/pages/fr/tarifs/index.astro. */
import Layout from '../../../layouts/Layout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import { offer, breadcrumbList } from '../../../lib/schema';
import site from '../../../data/site.json';

const translations = { fr: '/fr/tarifs/', en: '/en/prices/' };
---
<Layout
  title="Kitesurfing and Wingfoil Prices in Le Morne, Mauritius — PKM"
  description="2026 prices for kitesurfing and wingfoil lessons at Paradise Kitesurfing Mauritius, Le Morne: private, semi-private, rental, coaching, downwind. Per person, gear included."
  locale="en"
  translations={translations}
  tarifsHref="/en/prices/"
  waHref="/en/book/"
  jsonLd={[
    offer({
      name: '2h private kitesurfing lesson',
      description: '2-hour private lesson with instructor, Le Morne, gear included.',
      price: site.prices.kitesurfPrive['2h'],
      url: `${site.url}/en/prices/`,
    }),
    breadcrumbList([
      { name: 'Home', url: `${site.url}/en/` },
      { name: 'Prices', url: `${site.url}/en/prices/` },
    ]),
  ]}
>
  <section class="pad" style="padding-bottom:20px">
    <h1 style="font-size:1.9rem">Kitesurfing and wingfoil prices in Le Morne</h1>
    <p class="sub">2026 prices, per person, gear included. Mauritian rupees with the euro equivalent.</p>
    <div style="display:flex;gap:7px;flex-wrap:wrap;margin-top:12px">
      <span class="tag">Kite and board</span><span class="tag">Helmet and vest</span><span class="tag">Wetsuit</span><span class="tag">Equipment by package</span>
    </div>
  </section>

  <section class="pad" style="padding-top:6px">
    <h2 style="text-transform:uppercase;letter-spacing:.08em;font-size:.78rem;color:var(--ink-soft)">Kitesurfing</h2>

    <div class="group-deal">
      <span>Families and groups</span>
      <b>10% off from 3 people booked together</b>
      <p>Each person can choose a package for their own level. The reduction can be combined with the first supervised session free.</p>
    </div>

    <div class="pcard hot" style="margin:12px 0 14px">
      <div class="h">
        <h3>Private lesson <Badge>Most popular</Badge></h3>
        <div class="s">1 instructor per student</div>
      </div>
      <div class="body">
        <div class="row"><span>2 hours</span><b>Rs 8,000<span class="eur">€160</span></b></div>
        <div class="row"><span>6 hours<br /><small style="color:var(--sage-deep)">up to supervised riding</small><br /><span class="pill-offer">+ 1 supervised session free</span></span><b>Rs 23,250<span class="eur">€465</span></b></div>
        <div class="row"><span>8 hours</span><b>Rs 31,000<span class="eur">€620</span></b></div>
        <div class="row"><span>10 hours<br /><small style="color:var(--sage-deep)">full independence and IKO</small></span><b>Rs 38,000<span class="eur">€760</span></b></div>
      </div>
    </div>

    <div class="pcard" style="margin-bottom:14px">
      <div class="h">
        <h3>Semi-private lesson</h3>
        <div class="s">1 instructor per 2 students · one kite and board each · price per person</div>
      </div>
      <div class="body">
        <div class="row"><span>2 hours</span><b>Rs 4,500<span class="eur">€90</span></b></div>
        <div class="row"><span>6 hours<br /><small style="color:var(--sage-deep)">up to supervised riding</small><br /><span class="pill-offer">+ 1 supervised session free</span></span><b>Rs 12,500<span class="eur">€250</span></b></div>
        <div class="row"><span>8 hours</span><b>Rs 16,250<span class="eur">€325</span></b></div>
        <div class="row"><span>10 hours<br /><small style="color:var(--sage-deep)">full independence and IKO</small></span><b>Rs 19,250<span class="eur">€385</span></b></div>
      </div>
    </div>

    <div class="pcard" style="margin-bottom:14px">
      <div class="h">
        <h3>Gear rental</h3>
        <div class="s">Twintip and strapless · sliding rates for independent riders</div>
      </div>
      <div class="body">
        <div class="row"><span>Kite + board · 2h<br /><small>short format</small></span><b>Rs 2,250<span class="eur">€45</span></b></div>
        <div class="row"><span>Kite + board · 1 day<br /><small style="color:var(--sage-deep)">Rs 500 less than two 2h rentals</small></span><b>Rs 4,000<span class="eur">€80</span></b></div>
        <div class="row"><span>Kite + board · 1 week<br /><small style="color:var(--sage-deep)">long-stay rate</small></span><b>Rs 27,000<span class="eur">€540</span></b></div>
        <div class="row"><span>Supervision + rental · 2h<br /><small style="color:var(--sage-deep)">gear provided</small></span><b>Rs 3,250<span class="eur">€65</span></b></div>
        <div class="row"><span>Supervision only · 2h<br /><small style="color:var(--sage-deep)">with your own gear</small><br /><span class="pill-offer">Free if booked online</span></span><b>Rs 1,500<span class="eur">€30</span></b></div>
        <p class="sub" style="font-size:.88rem;padding-top:12px">
          The longer you keep the gear, the lower the average rate. Twintip
          or strapless subject to availability, with size changes when
          conditions evolve. Harness, helmet and vest included.
        </p>
        <div style="background:var(--sage-pale);border-radius:13px;padding:13px 14px;margin-top:14px">
          <div style="font-family:var(--font-display);font-weight:600;font-size:.88rem;margin-bottom:5px">What a supervised session includes</div>
          <p class="sub" style="font-size:.86rem;margin:0">
            An instructor watches you from the beach or the water, helps
            launch and land the kite, and comes to get you if things go
            wrong. Technical correction is worked on in lessons or coaching.
          </p>
        </div>
      </div>
    </div>

    <div class="pcard" style="margin-bottom:14px;border-color:var(--sage)">
      <div class="h" style="background:var(--sage-pale)">
        <h3>Hourly coaching <Badge>On request</Badge></h3>
        <div class="s">Twintip or strapless. One or two hours on a precise goal with an instructor riding beside you.</div>
        <span class="pill-offer">+ 1 supervised session free</span>
      </div>
      <div class="body">
        <p class="sub" style="font-size:.88rem;padding-top:12px">
          <b>Twintip</b>: riding upwind, first jump, transitions, rotations.<br />
          <b>Strapless</b>: moving from twintip to directional, jibe, first
          waves at Small Reef then Manawa.<br />
          With your own gear, or ours for an extra fee. Bookable the day
          before, depending on the wind window. The price is confirmed on
          WhatsApp based on the duration and equipment required.
        </p>
        <Button variant="ghost" block href="/en/book/">Ask for a quote</Button>
      </div>
    </div>

    <h2 style="text-transform:uppercase;letter-spacing:.08em;font-size:.78rem;color:var(--ink-soft);margin-top:26px">Wingfoil</h2>

    <div class="pcard" style="margin:12px 0 14px">
      <div class="h"><h3>Private wingfoil</h3><div class="s">1 instructor per student</div></div>
      <div class="body">
        <div class="row"><span>2 hours</span><b>Rs 8,500<span class="eur">€170</span></b></div>
        <div class="row"><span>6 hours</span><b>Rs 24,500<span class="eur">€490</span></b></div>
        <div class="row"><span>8 hours</span><b>Rs 32,500<span class="eur">€650</span></b></div>
        <div class="row"><span>10 hours</span><b>Rs 39,500<span class="eur">€790</span></b></div>
      </div>
    </div>

    <div class="pcard" style="margin-bottom:14px">
      <div class="h"><h3>Semi-private wingfoil</h3><div class="s">Price per person</div></div>
      <div class="body">
        <div class="row"><span>2 hours</span><b>Rs 7,000<span class="eur">€140</span></b></div>
        <div class="row"><span>6 hours</span><b>Rs 20,000<span class="eur">€400</span></b></div>
        <div class="row"><span>8 hours</span><b>Rs 26,500<span class="eur">€530</span></b></div>
        <div class="row"><span>10 hours</span><b>Rs 32,500<span class="eur">€650</span></b></div>
      </div>
    </div>

    <div class="pcard" style="margin-bottom:14px">
      <div class="h"><h3>Downwind and VIP lessons</h3><div class="s">On request</div></div>
      <div class="body">
        <p class="sub" style="font-size:.9rem;padding-top:10px">
          The price depends on the number of participants: safety boat,
          skipper and guide are shared. Downwind from 4 people, 8 maximum. A
          priced answer within 2h on WhatsApp.
        </p>
        <Button variant="ghost" block href="/en/book/">Ask for a quote</Button>
      </div>
    </div>

    <div style="background:var(--surface);border-radius:16px;padding:18px;margin-top:8px">
      <h3>What the price always includes</h3>
      <p class="sub" style="font-size:.9rem;margin:8px 0 0">
        The gear and safety equipment listed for the package, plus the
        instructor's fee for a lesson. VHF radio is used for suitable
        learning formats and is not advertised for advanced coaching. If
        there is no wind, the session is rescheduled at no cost.
      </p>
    </div>
  </section>

  <section class="pad">
    <p class="sub">
      Want to compare with the rest of the market? <a href="/en/guide/kitesurfing-mauritius-cost/" style="color:var(--coral);font-weight:600;text-decoration:none">See the real price ranges at Le Morne →</a>
    </p>
  </section>
</Layout>

<style>
  .tag {
    display: inline-flex; align-items: center; font-family: var(--font-display);
    font-weight: 500; font-size: .74rem; padding: 5px 10px; border-radius: var(--radius-pill);
    background: var(--sage-pale); color: var(--sage-deep);
  }
</style>
