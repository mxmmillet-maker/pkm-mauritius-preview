---
import Layout from '../../../layouts/Layout.astro';
import LegalPage from '../../../components/LegalPage.astro';
import site from '../../../data/site.json';
const translations = { fr: '/fr/confidentialite/', en: '/en/privacy/', de: '/de/datenschutz/' };
const sections = [
  { title: 'Data we use', paragraphs: ['When you ask for a program or booking, we process the information you enter: first name, WhatsApp number, travel dates, level and requested activity. Any subsequent WhatsApp conversation is then handled by that service.', 'If you consent to audience measurement, non-directly identifying technical data may be collected, such as pages viewed, language, device type and clicks on key actions. Message content, telephone numbers and email addresses are never sent to the analytics tool.'] },
  { title: 'Why we use it', items: ['To answer your enquiry and suggest suitable times or packages.', 'To prepare and manage the booking, including changes caused by wind conditions.', 'With your consent only, to measure site performance and improve contact journeys.'] },
  { title: 'Recipients and retention', paragraphs: ['Enquiries are accessible only to the PKM team and technical providers strictly required to operate the service. An enquiry that does not lead to a booking is kept for no more than 12 months after the last exchange, unless law requires otherwise or you ask for earlier deletion.', 'WhatsApp is a Meta service and may process data outside Mauritius. Please review its own privacy terms before continuing the conversation.'] },
  { title: 'Analytics and cookies', paragraphs: ['No audience measurement tool is loaded before you consent. Your choice is stored in your browser for 180 days. You can change it or withdraw consent at any time using the “Manage cookies” button available on every page. No advertising tracking is planned.'] },
  { title: 'Your rights', paragraphs: [`You may request access, correction or deletion of your data, or object to its use, by emailing <a href="mailto:${site.email}">${site.email}</a>. We may ask for information needed to verify that the request concerns your data.`] },
];
---
<Layout title="Privacy policy — Paradise Kitesurfing Mauritius" description="How Paradise Kitesurfing Mauritius uses and protects data sent with a booking enquiry." locale="en" translations={translations} tarifsHref="/en/prices/" waHref="/en/book/">
  <LegalPage eyebrow="Personal data" title="Privacy policy" intro="A clear explanation of the information used when you contact PKM through the website." sections={sections} updated="Last updated: 19 August 2026." />
</Layout>
