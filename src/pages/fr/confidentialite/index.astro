---
import Layout from '../../../layouts/Layout.astro';
import LegalPage from '../../../components/LegalPage.astro';
import site from '../../../data/site.json';
const translations = { fr: '/fr/confidentialite/', en: '/en/privacy/', de: '/de/datenschutz/' };
const sections = [
  { title: 'Données concernées', paragraphs: ['Lorsque tu demandes un programme ou une réservation, nous traitons les informations que tu saisis : prénom, numéro WhatsApp, dates de séjour, niveau ou activité recherchée. Les échanges poursuivis dans WhatsApp relèvent ensuite de ce service.', 'Si tu acceptes la mesure d’audience, des données techniques non directement identifiantes peuvent être collectées : pages vues, langue, type d’appareil et clics sur les actions principales. Le contenu des messages, les numéros et les adresses e-mail ne sont pas envoyés à l’outil de mesure.'] },
  { title: 'Pourquoi nous les utilisons', items: ['Répondre à ta demande et proposer des créneaux ou une formule adaptée.', 'Préparer et gérer la réservation, notamment les changements liés aux conditions de vent.', 'Mesurer, uniquement avec ton accord, les performances du site et les parcours qui facilitent une prise de contact.'] },
  { title: 'Destinataires et conservation', paragraphs: ['Les demandes sont accessibles uniquement à l’équipe PKM et aux prestataires techniques strictement nécessaires au fonctionnement du service. Une demande sans suite est conservée au maximum 12 mois après le dernier échange, sauf obligation légale ou demande de suppression anticipée.', 'WhatsApp est un service de Meta et peut traiter des données hors de Maurice. Nous t’invitons à consulter ses propres conditions de confidentialité avant de poursuivre la conversation.'] },
  { title: 'Mesure d’audience et cookies', paragraphs: ['Aucun outil de mesure d’audience n’est chargé avant ton accord. Ton choix est enregistré dans le navigateur et peut être supprimé à tout moment en effaçant les données du site. Aucun suivi publicitaire n’est prévu.'] },
  { title: 'Tes droits', paragraphs: [`Tu peux demander l’accès, la rectification ou la suppression de tes données, ou t’opposer à leur utilisation, en écrivant à <a href="mailto:${site.email}">${site.email}</a>. Nous pourrons demander les informations nécessaires pour vérifier que la demande concerne bien tes données.`] },
];
---
<Layout title="Confidentialité et données personnelles — PKM" description="Comment Paradise Kitesurfing Mauritius utilise et protège les données envoyées lors d’une demande de réservation." locale="fr" translations={translations} tarifsHref="/fr/tarifs/" waHref="/fr/reserver/">
  <LegalPage eyebrow="Données personnelles" title="Politique de confidentialité" intro="Une explication simple des informations utilisées lorsque tu contactes PKM depuis le site." sections={sections} updated="Dernière mise à jour : 19 août 2026." />
</Layout>
