---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import PriceFrom from '../../components/PriceFrom.astro';
import ProfileSlider from '../../components/ProfileSlider.astro';
import Faq from '../../components/Faq.astro';
import { sportsActivityLocation, faqPage, breadcrumbList } from '../../lib/schema';
import site from '../../data/site.json';

const translations = { fr: '/fr/', en: '/en/' };
const waPhone = site.phones[0].replace(/\D/g, '');
const waLink = `https://wa.me/${waPhone}?text=${encodeURIComponent("Bonjour l'équipe PKM, j'aimerais organiser des séances au Morne.")}`;
const googleReviewsUrl = 'https://www.google.com/maps/search/?api=1&query=Paradise+Kitesurfing+Mauritius+Le+Morne';

const profiles = [
  {
    eyebrow: 'Première fois', title: 'Je débute',
    text: 'Découvrir l’aile, le waterstart et avancer vers un ride surveillé sur le lagon.',
    href: '/fr/cours-de-kitesurf/', image: '/images/kitesurf-family-lesson-pexels.jpg',
    alt: 'Un jeune élève apprend à manier une aile avec un moniteur', linkLabel: 'Voir les cours débutants',
  },
  {
    eyebrow: 'Reprise', title: 'Je veux reprendre confiance',
    text: 'Une remise à l’eau adaptée à ton niveau pour retrouver tes repères sans repartir de zéro.',
    href: '/fr/cours-de-kitesurf/#reprise', image: '/images/kitesurf-lesson-pexels.jpg',
    alt: 'Une élève accompagnée par son moniteur pendant une séance de kitesurf', linkLabel: 'Préparer ma reprise',
  },
  {
    eyebrow: 'Freestyle', title: 'Je veux passer un cap',
    text: 'Remontée au vent, toeside, transitions, premiers sauts ou rotations selon ton objectif.',
    href: '/fr/perfectionnement/#freestyle', image: '/images/kitesurf-freestyle-jump-pexels.jpg',
    alt: 'Un kitesurfeur effectue un saut au-dessus de l’eau', linkLabel: 'Explorer le coaching freestyle',
  },
  {
    eyebrow: 'Vagues', title: 'Je veux rider les vagues',
    text: 'Placement, jibe, lecture de vague et autonomie progressive entre Small Reef et Manawa.',
    href: '/fr/perfectionnement/#vagues', image: '/images/kitesurf-wave-riding-pexels.jpg',
    alt: 'Un kitesurfeur navigue dans les vagues près de la côte', linkLabel: 'Voir le parcours vagues',
  },
  {
    eyebrow: 'Wingfoil', title: 'Je veux essayer le wingfoil',
    text: 'Découverte, premiers vols ou progression sur le foil, en formule privée ou semi-privée.',
    href: '/fr/tarifs/#wingfoil', image: '/images/wingfoil-pexels.jpg',
    alt: 'Un wingfoiler glisse au-dessus d’une eau turquoise', linkLabel: 'Voir les sessions wingfoil',
  },
];

const faqItems = [
  {
    question: 'Peut-on venir avec des niveaux différents ?',
    answer: "Oui. Une famille ou un couple peut construire un programme commun avec des séances différentes : débutant au lagon, reprise en confiance, coaching freestyle ou accompagnement dans les vagues. À partir de trois personnes réservées ensemble, une réduction de 10 % s'applique.",
  },
  {
    question: "Que se passe-t-il s'il n'y a pas de vent ?",
    answer: 'La séance est déplacée sur un autre créneau sans frais. Le programme est ajusté à la météo pendant ton séjour.',
  },
  {
    question: 'Combien coûte un cours de kitesurf au Morne ?',
    answer: "Le cours semi-privé de 2 h est à Rs 4 500 par personne et le cours privé à Rs 8 000. Le matériel et les équipements de sécurité prévus pour la formule sont compris.",
  },
  {
    question: 'Comment réserver ?',
    answer: "Envoie tes dates, ton niveau et le nombre de participants. L’équipe te répond sur WhatsApp avec un programme et les créneaux disponibles. Un acompte de 10 % confirme ensuite la réservation.",
  },
];
---

<Layout
  title="École de kitesurf au Morne, Île Maurice — Paradise Kitesurfing Mauritius"
  description="Cours débutants, reprise, coaching freestyle, vagues et wingfoil au Morne. Programmes adaptés aux familles et aux niveaux mixtes."
  locale="fr"
  translations={translations}
  tarifsHref="/fr/tarifs/"
  waHref="/fr/reserver/"
  jsonLd={[
    sportsActivityLocation(),
    faqPage(faqItems),
    breadcrumbList([{ name: 'Accueil', url: `${site.url}/fr/` }]),
  ]}
>
  <section class="hero-photo pad">
    <img class="hero-photo__media" src="/images/kitesurf-lagoon-aerial-pexels.jpg" alt="Kitesurfeur vu du ciel le long d’un récif dans une eau turquoise" width="1800" height="1013" fetchpriority="high" />
    <span class="hero-photo__shade" aria-hidden="true"></span>
    <div class="hero-photo__copy">
      <span class="kicker">Le Morne, île Maurice</span>
      <h1>Du premier waterstart aux vagues du Morne</h1>
      <p>Débutant, en reprise ou déjà autonome, l’équipe construit avec toi un programme adapté à ton niveau et aux conditions du jour.</p>
      <div class="hero-actions">
        <Button variant="wa" href={waLink}>Discuter sur WhatsApp</Button>
        <Button variant="line" href="/fr/cours-de-kitesurf/">Découvrir les cours</Button>
      </div>
      <small class="hero-photo__credit">Photo d’ambiance, libre d’usage</small>
    </div>
  </section>

  <section class="trust-strip pad" aria-label="Repères de confiance">
    <a class="trust-card trust-card--google" href={googleReviewsUrl} target="_blank" rel="noreferrer">
      <span class="trust-brand"><img src="/images/google-g.svg" alt="" width="24" height="24" /><strong>Google</strong></span>
      <span class="trust-score"><b>{site.googleReviews.rating.toFixed(1).replace('.', ',')}</b><span class="stars" aria-label="5 étoiles">★★★★★</span></span>
      <small>{site.googleReviews.count} avis publics</small>
      <span class="trust-link">Voir les avis →</span>
    </a>
    <a class="trust-card trust-card--tripadvisor" href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">
      <span class="trust-brand"><img src="/images/tripadvisor.svg" alt="" width="28" height="28" /><strong>TripAdvisor</strong></span>
      <span class="trust-score"><b>{site.tripAdvisorReviews.rating.toFixed(1).replace('.', ',')}</b><span class="stars" aria-label="5 étoiles">★★★★★</span></span>
      <small>{site.tripAdvisorReviews.count} avis publics</small>
      <span class="trust-link">Voir les avis →</span>
    </a>
    <a class="trust-card trust-card--deal" href="/fr/reserver/">
      <span class="deal-badge">−10 %</span>
      <strong>Offre famille & groupe</strong>
      <small>Dès 3 personnes réservées ensemble</small>
      <span class="trust-link">Composer le séjour →</span>
    </a>
  </section>

  <section class="pad profile-section">
    <span class="kicker">Ton programme</span>
    <h2>Tu veux faire quoi sur l’eau ?</h2>
    <p class="sub">Fais glisser les cartes. Chacun peut suivre son propre parcours, même quand vous venez en famille ou en couple.</p>
    <ProfileSlider items={profiles} label="Choisir un parcours selon son niveau" />
  </section>

  <section class="pad spot-section">
    <div>
      <span class="kicker">Le spot</span>
      <h2>Le lagon, un vrai terrain de progression</h2>
      <p class="sub">Il y a du très flat pour travailler un geste, du clapot pour tenter ses premiers sauts et assez d’espace pour s’éloigner des autres cours. Le fond sableux et les zones où l’on a pied rendent l’apprentissage plus confortable.</p>
    </div>
    <div class="windbox">
      <h3>Quand venir</h3>
      <div class="wgrid">
        <div class="peak"><b>Juin → septembre</b><small>18 à 35 nœuds · saison forte</small></div>
        <div><b>Avril, mai, oct., nov.</b><small>10 à 25 nœuds · plus chaud</small></div>
        <div><b>Déc. → mars</b><small>10 à 25 nœuds · moins de jours ventés</small></div>
        <div><b>Toute l’année</b><small>Eau entre 22 et 28 °C</small></div>
      </div>
      <p class="data-note">Des repères saisonniers, pas une promesse météo : les créneaux sont ajustés à la prévision réelle de ton séjour.</p>
    </div>
  </section>

  <section class="pad progression-section">
    <span class="kicker">Perfectionnement</span>
    <h2>Progresser en freestyle ou en surf</h2>
    <p class="sub">Deux chemins différents, avec un point de départ choisi après une première lecture de ton niveau.</p>
    <div class="track-grid">
      <article class="track-card" id="freestyle">
        <span>Freestyle · lagon</span>
        <h3>Gagner en contrôle puis en amplitude</h3>
        <ol>
          <li><b>Reprise</b><small>Cap, remontée au vent, transitions</small></li>
          <li><b>Intermédiaire</b><small>Toeside, pop, premiers sauts</small></li>
          <li><b>Avancé</b><small>Rotations et objectifs ciblés</small></li>
        </ol>
        <a href="/fr/perfectionnement/#freestyle">Voir le coaching freestyle →</a>
      </article>
      <article class="track-card track-card--wave" id="vagues">
        <span>Surf · récif</span>
        <h3>De la directionnelle à l’autonomie dans les vagues</h3>
        <ol>
          <li><b>Small Reef</b><small>Jibe, placement, premières lignes</small></li>
          <li><b>Chameaux et Manawa</b><small>Lecture, turns, zone stratégique</small></li>
          <li><b>One Eye</b><small>Seulement si niveau et conditions adaptés</small></li>
        </ol>
        <a href="/fr/perfectionnement/#vagues">Voir le parcours vagues →</a>
      </article>
    </div>
    <div class="reassure">
      <b>Tu débutes ? Le lagon suffit largement.</b>
      <p>On y trouve du flat, du clapot, de l’espace et plusieurs zones de travail. Tu peux progresser toute la semaine sans aller sur le récif.</p>
    </div>
  </section>

  <section class="pad family-offer">
    <div>
      <span class="kicker">Familles et couples</span>
      <h2>Un séjour commun, plusieurs niveaux</h2>
      <p>Un parent autonome peut travailler les vagues pendant qu’un autre reprend confiance et qu’un jeune débute. Un couple peut aussi partager une séance avec deux objectifs différents lorsque le format le permet.</p>
      <ul class="clean-list">
        <li>10 % de réduction dès 3 personnes réservées ensemble</li>
        <li>Programme construit selon le niveau de chacun</li>
        <li>Première séance surveillée offerte, offre cumulable</li>
      </ul>
      <Button variant="primary" href="/fr/reserver/">Composer notre programme</Button>
    </div>
    <img src="/images/kitesurf-family-lesson-pexels.jpg" alt="Un élève apprend à piloter une aile avec son moniteur" width="1600" height="1067" loading="lazy" />
  </section>

  <section class="pad prices-preview">
    <span class="kicker">Repères tarifaires</span>
    <h2>Choisir une première formule</h2>
    <div class="fromgrid">
      <PriceFrom label="Cours à partir de" amount="4 500" currency="Rs · ≈ 90 €" detail="2 h en semi-privé, par personne" />
      <PriceFrom label="Location à partir de" amount="2 250" currency="Rs · ≈ 45 €" detail="2 h, aile et planche" />
    </div>
    <div class="offer-lite"><b>Location dégressive :</b> 2 h, journée ou semaine. Le tarif baisse quand la durée augmente.</div>
    <Button variant="ghost" href="/fr/tarifs/">Comparer toutes les formules</Button>
  </section>

  <section class="pad school-section">
    <div class="school-intro">
      <span class="kicker">L’équipe</span>
      <h2>Plusieurs personnes, du premier message à la mise à l’eau</h2>
      <p>Sur WhatsApp, au matériel, sur le lagon et en bateau, l’équipe se relaie pour préparer les séances et adapter le programme aux conditions.</p>
      <div class="auth">
        <div><b>Accueil</b><span>réponse et planning sur WhatsApp</span></div>
        <div><b>Moniteurs</b><span>plusieurs profils présents en saison</span></div>
        <div><b>Logistique</b><span>parc Duotone, préparation et bateau</span></div>
        <div><b>2 max.</b><span>élèves par moniteur</span></div>
      </div>
    </div>
    <div class="team-gallery" aria-label="L’équipe en action">
      <figure>
        <img src="/images/kitesurf-lesson-pexels.jpg" alt="Moniteur accompagnant une élève pendant une leçon" width="1800" height="1187" loading="lazy" />
        <figcaption>Sur l’eau · photo d’ambiance</figcaption>
      </figure>
      <figure>
        <img src="/images/kitesurf-family-lesson-pexels.jpg" alt="Moniteur préparant une aile avec un jeune élève" width="1600" height="1067" loading="lazy" />
        <figcaption>Préparation · photo d’ambiance</figcaption>
      </figure>
    </div>
  </section>

  <section class="pad reviews-section">
    <span class="kicker">Avis</span>
    <h2>Deux plateformes, les mêmes points forts</h2>
    <p class="sub">Quelques extraits d’avis publics. Fais glisser les cartes sur mobile, puis ouvre la plateforme pour lire les retours complets.</p>
    <div class="review-platforms">
      <article>
        <span class="platform-title"><img src="/images/google-g.svg" alt="" width="24" height="24" />Google</span>
        <h3>Google · {site.googleReviews.count} avis</h3>
        <p>Les retours publics mettent en avant la patience, la sécurité et l’accompagnement personnalisé.</p>
        <a href={googleReviewsUrl} target="_blank" rel="noreferrer">Voir les avis Google →</a>
      </article>
      <article>
        <span class="platform-title"><img src="/images/tripadvisor.svg" alt="" width="28" height="28" />TripAdvisor</span>
        <h3>TripAdvisor · {site.tripAdvisorReviews.count} avis</h3>
        <p>La fiche affiche une note de {site.tripAdvisorReviews.rating.toFixed(1).replace('.', ',')} / 5.</p>
        <a href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">Voir les avis TripAdvisor →</a>
      </article>
    </div>
    <div class="review-snaps" aria-label="Extraits d’avis clients">
      <a class="review-snap" href={googleReviewsUrl} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/google-g.svg" alt="" width="20" height="20" />Google</span><span class="stars" aria-label="5 étoiles">★★★★★</span></span>
        <blockquote>« Je me suis senti très en sécurité et pleinement accompagné. »</blockquote>
        <span class="review-snap__meta"><b>Nicolas O.</b><small>Octobre 2025 · traduit de l’anglais</small></span>
      </a>
      <a class="review-snap" href={googleReviewsUrl} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/google-g.svg" alt="" width="20" height="20" />Google</span><span class="stars" aria-label="5 étoiles">★★★★★</span></span>
        <blockquote>« De très bons moniteurs, incroyablement patients. »</blockquote>
        <span class="review-snap__meta"><b>Neil B.</b><small>Octobre 2025 · traduit de l’anglais</small></span>
      </a>
      <a class="review-snap" href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/tripadvisor.svg" alt="" width="23" height="23" />TripAdvisor</span><span class="stars" aria-label="5 étoiles">★★★★★</span></span>
        <blockquote>« Patients, accueillants, professionnels et toujours avec un grand sourire. »</blockquote>
        <span class="review-snap__meta"><b>Z0e2011</b><small>Juillet 2024 · traduit de l’anglais</small></span>
      </a>
      <a class="review-snap" href={site.tripAdvisorReviews.url} target="_blank" rel="noreferrer">
        <span class="review-snap__top"><span><img src="/images/tripadvisor.svg" alt="" width="23" height="23" />TripAdvisor</span><span class="stars" aria-label="5 étoiles">★★★★★</span></span>
        <blockquote>« Une équipe extrêmement sympathique, patiente et adaptable. »</blockquote>
        <span class="review-snap__meta"><b>Vlassis T.</b><small>Octobre 2023 · traduit de l’anglais</small></span>
      </a>
    </div>
  </section>

  <section class="pad faq-section">
    <span class="kicker">FAQ</span>
    <h2>Questions fréquentes</h2>
    <Faq items={faqItems} />
  </section>

  <section class="pad final-cta" id="capture">
    <span class="kicker">Nou ale ?</span>
    <h2>Organise ton stage, ton coaching ou tes séances</h2>
    <p>Envoie tes dates et les niveaux du groupe. L’équipe te propose un programme réaliste sur WhatsApp.</p>
    <div class="hero-actions">
      <Button variant="wa" href={waLink}>Discuter avec l’équipe</Button>
      <Button variant="line" href="/fr/reserver/">Décrire mon séjour</Button>
    </div>
  </section>
</Layout>
