---
import Layout from '../../../../layouts/Layout.astro';
import Faq from '../../../../components/Faq.astro';
import Button from '../../../../components/Button.astro';
import { faqPage, breadcrumbList } from '../../../../lib/schema';
import site from '../../../../data/site.json';

const translations = {
  fr: '/fr/guide/budget-kitesurf-ile-maurice/',
  en: '/en/guide/kitesurfing-mauritius-cost/',
  de: '/de/guide/kosten-kitesurfen-mauritius/',
};

const faqItems = [
  {
    question: 'Combien coûte un cours de kitesurf à Maurice ?',
    answer: 'Chez PKM, 2 heures en privé coûtent Rs 8 000. En semi-privé à deux, le tarif est de Rs 4 500 par personne. Pour comparer avec une autre école, vérifie toujours la même durée et le même nombre d’élèves par moniteur.',
  },
  {
    question: 'PKM est-elle plus chère que les autres écoles du Morne ?',
    answer: 'PKM se situe dans une zone tarifaire compétitive. Born to Kite est généralement un peu moins cher selon la formule, LMKS un peu plus cher et ION CLUB nettement plus cher.',
  },
  {
    question: 'Que faut-il comparer avant de choisir une école ?',
    answer: 'Compare la durée réelle du cours, le ratio élève/moniteur, le matériel inclus, le bateau de sécurité, les conditions sans vent et le contenu du forfait.',
  },
];
---
<Layout
  title="Combien coûte un cours de kitesurf à Maurice ? | PKM"
  description="Compare les tarifs des écoles de kitesurf au Morne à durée et ratio identiques. Positionnement de PKM face à Born to Kite, LMKS et ION CLUB."
  locale="fr"
  translations={translations}
  tarifsHref="/fr/tarifs/"
  waHref="/fr/reserver/"
  jsonLd={[
    faqPage(faqItems),
    breadcrumbList([
      { name: 'Accueil', url: `${site.url}/fr/` },
      { name: 'Guides', url: `${site.url}/fr/guide/` },
      { name: 'Budget', url: `${site.url}/fr/guide/budget-kitesurf-ile-maurice/` },
    ]),
  ]}
>
  <section class="pad">
    <span class="kicker">Guide</span>
    <h1>Combien coûte un cours de kitesurf à Maurice ?</h1>
    <p class="sub">
      PKM se place dans une zone tarifaire compétitive au Morne. À formule
      comparable, Born to Kite est généralement un peu moins cher, LMKS un peu
      plus cher et ION CLUB nettement plus cher.
    </p>
  </section>

  <section class="pad">
    <h2>Le bon classement des prix au Morne</h2>
    <p><b>Born to Kite :</b> généralement un peu moins cher que PKM, selon la durée et la formule retenues.</p>
    <p><b>Paradise Kitesurfing Mauritius :</b> le repère de comparaison, avec Rs 8 000 pour 2 h en privé et Rs 4 500 par personne pour 2 h en semi-privé à deux.</p>
    <p><b>LMKS :</b> légèrement plus cher que PKM sur les cours privés et plusieurs forfaits comparables.</p>
    <p><b>ION CLUB :</b> nettement plus cher que PKM, avec un positionnement de centre international.</p>
    <p class="sub">
      Les grilles changent selon les saisons. Ce classement sert à situer les
      écoles entre elles, sans fabriquer une moyenne à partir de cours qui
      n'ont ni la même durée ni le même ratio d'encadrement.
    </p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>Le repère PKM</h2>
    <p>
      Chez Paradise Kitesurfing Mauritius, le cours privé réunit 1 moniteur et
      1 élève pendant 2 h pour Rs 8 000. Le semi-privé réunit 1 moniteur et 2
      élèves pendant 2 h pour Rs 4 500 par personne. Les forfaits de 6, 8 et
      10 heures rendent ensuite le tarif dégressif.
    </p>
    <p class="sub" style="font-size:.9rem">Matériel compris. Le détail et les forfaits à jour sont disponibles sur la page tarifs.</p>
  </section>

  <section class="pad">
    <h2>Comment comparer sans se tromper</h2>
    <p><b>Même durée :</b> compare un cours de 2 h avec un autre cours de 2 h, ou un forfait de 6 h avec un forfait de 6 h.</p>
    <p><b>Même encadrement :</b> un cours privé 1 pour 1 ne se compare pas au prix par personne d'un groupe de 3 ou 4 élèves.</p>
    <p><b>Mêmes services :</b> vérifie le matériel, l'assurance, le bateau de sécurité, le transport éventuel et les conditions prévues quand le vent manque.</p>
  </section>

  <section class="pad" style="text-align:center">
    <Button variant="primary" href="/fr/tarifs/">Voir les tarifs PKM</Button>
  </section>

  <section class="pad">
    <h2>Questions fréquentes</h2>
    <Faq items={faqItems} />
  </section>
</Layout>
