---
import Layout from '../../../../layouts/Layout.astro';
import Faq from '../../../../components/Faq.astro';
import Button from '../../../../components/Button.astro';
import { faqPage, breadcrumbList } from '../../../../lib/schema';
import site from '../../../../data/site.json';

const translations = {
  fr: '/fr/guide/budget-kitesurf-ile-maurice/',
  en: '/en/guide/kitesurfing-mauritius-cost/',
  de: '/de/guide/kosten-kitesurfen-mauritius/',
};

const faqItems = [
  {
    question: 'Combien coûte un cours de kitesurf à Maurice ?',
    answer: 'Au Morne, compte généralement entre Rs 1 900 et Rs 3 000 par heure et par personne en semi-privé à deux. En privé avec un moniteur pour un élève, la fourchette se situe autour de Rs 3 800 à Rs 5 000 par heure.',
  },
  {
    question: 'Quel rapport qualité-prix propose PKM ?',
    answer: 'PKM se situe dans la partie compétitive des fourchettes observées, avec Rs 4 000 par heure en privé et Rs 2 250 par heure et par personne en semi-privé sur une séance de 2 heures. Les forfaits font encore baisser le tarif horaire.',
  },
  {
    question: 'Que faut-il comparer avant de choisir une école ?',
    answer: 'Compare la durée réelle du cours, le ratio élève/moniteur, le matériel inclus, le bateau de sécurité, les conditions sans vent et le contenu du forfait.',
  },
];
---
<Layout
  title="Combien coûte un cours de kitesurf à Maurice ? | PKM"
  description="Fourchettes horaires des cours de kitesurf au Morne et conseils pour comparer le ratio d'encadrement, le matériel et la sécurité."
  locale="fr"
  translations={translations}
  tarifsHref="/fr/tarifs/"
  waHref="/fr/reserver/"
  jsonLd={[
    faqPage(faqItems),
    breadcrumbList([
      { name: 'Accueil', url: `${site.url}/fr/` },
      { name: 'Guides', url: `${site.url}/fr/guide/` },
      { name: 'Budget', url: `${site.url}/fr/guide/budget-kitesurf-ile-maurice/` },
    ]),
  ]}
>
  <section class="pad">
    <span class="kicker">Guide</span>
    <h1>Combien coûte un cours de kitesurf à Maurice ?</h1>
    <p class="sub">
      Au Morne, compte généralement <b>Rs 1 900 à Rs 3 000 par heure et par
      personne en semi-privé</b>, et <b>Rs 3 800 à Rs 5 000 par heure en
      privé</b>. La bonne comparaison commence par le ratio d'encadrement et
      les services réellement inclus.
    </p>
  </section>

  <section class="pad">
    <h2>Fourchettes horaires constatées au Morne</h2>
    <p><b>Semi-privé, 2 élèves :</b> environ Rs 1 900 à Rs 3 000 par heure et par personne.</p>
    <p><b>Privé, 1 moniteur pour 1 élève :</b> environ Rs 3 800 à Rs 5 000 par heure.</p>
    <p><b>Forfaits de plusieurs séances :</b> le prix horaire baisse généralement à partir de 6 heures réservées.</p>
    <p class="sub">
      Ces repères sont calculés à partir de grilles publiques disponibles pour
      le Morne. Ils restent indicatifs : la saison, le nombre d'élèves, le
      matériel et les services inclus peuvent faire varier le prix.
    </p>
  </section>

  <section class="pad" style="background:var(--surface)">
    <h2>Où se situe PKM</h2>
    <p>
      Une séance de 2 heures revient à <b>Rs 4 000 par heure en privé</b> et à
      <b>Rs 2 250 par heure et par personne en semi-privé</b>. Sur le forfait
      de 10 heures, le tarif descend à Rs 3 800 par heure en privé et à
      Rs 1 925 par heure et par personne en semi-privé.
    </p>
    <p class="sub" style="font-size:.9rem">Matériel compris. Le détail et les forfaits à jour sont disponibles sur la page tarifs.</p>
  </section>

  <section class="pad">
    <h2>Ce que tu achètes avec le cours</h2>
    <p><b>Un encadrement resserré :</b> 2 élèves maximum par moniteur, avec une aile et une planche pour chacun en semi-privé.</p>
    <p><b>La sécurité sur le spot :</b> casque et gilet, bateau disponible selon le programme et les conditions, radio VHF sur les formats d'apprentissage adaptés.</p>
    <p><b>Une réservation plus sereine :</b> si le vent manque, la séance est reportée sans frais.</p>
  </section>

  <section class="pad" style="text-align:center">
    <Button variant="primary" href="/fr/tarifs/">Voir les tarifs PKM</Button>
  </section>

  <section class="pad">
    <h2>Questions fréquentes</h2>
    <Faq items={faqItems} />
  </section>
</Layout>
