---
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/tokens.css';
import '../styles/blocks.css';

import Topbar from '../components/Topbar.astro';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { NAV, hreflangLinks } from '../lib/i18n';
import site from '../data/site.json';

/*
  title / description : uniques par page, jamais génériques (règle SEO du brief).
  locale               : 'fr' | 'en' | 'de'
  translations         : { fr: '/fr/...', en: '/en/...', de: '/de/...' } — équivalents réels de CETTE page
  jsonLd               : tableau d'objets schema.org (voir lib/schema.js)
  tarifsHref / waHref  : liens du Dock, propres à chaque page/langue
*/
const {
  title,
  description,
  locale,
  translations = {},
  jsonLd = [],
  tarifsHref,
  waHref,
  scrollRefresh = false,
  ogImage = '/images/pkm-hero-desktop.webp',
  ogImageAlt,
  noindex = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL ?? '/';
const basePath = baseUrl === '/' ? '' : baseUrl.replace(/\/$/, '');
const withBase = (path) => `${basePath}/${path.replace(/^\/+/, '')}`;
const canonical = new URL(withBase(translations[locale] ?? Astro.url.pathname), Astro.site);
const socialImage = new URL(withBase(ogImage), Astro.site);
const isPreview = basePath !== '';
const alternates = hreflangLinks(translations, Astro.site, baseUrl);
const footerColumns = locale === 'fr'
  ? [
      { title: 'École', links: [
        { label: 'Cours de kitesurf', href: '/fr/cours-de-kitesurf/' },
        { label: 'Tarifs', href: '/fr/tarifs/' },
        { label: 'Réserver', href: '/fr/reserver/' },
      ] },
      { title: 'Préparer son séjour', links: [
        { label: 'Le spot du Morne', href: '/fr/kitesurf-le-morne/' },
        { label: 'Guides', href: '/fr/guide/' },
        { label: 'Questions fréquentes', href: '/fr/questions-frequentes/' },
      ] },
    ]
  : locale === 'de'
    ? [
        { title: 'Kiteschule', links: [
          { label: 'Kitesurfkurse', href: '/de/kitesurf-kurse/' },
          { label: 'Preise', href: '/de/preise/' },
          { label: 'Buchen', href: '/de/buchen/' },
        ] },
        { title: 'Reise planen', links: [
          { label: 'Der Spot Le Morne', href: '/de/kitesurfen-le-morne/' },
          { label: 'Guides', href: '/de/guide/' },
          { label: 'Häufige Fragen', href: '/de/faq/' },
        ] },
      ]
    : [
      { title: 'School', links: [
        { label: 'Kitesurf lessons', href: '/en/kitesurf-lessons/' },
        { label: 'Prices', href: '/en/prices/' },
        { label: 'Book', href: '/en/book/' },
      ] },
      { title: 'Plan your trip', links: [
        { label: 'The Le Morne spot', href: '/en/kitesurf-le-morne/' },
        { label: 'Guides', href: '/en/guide/' },
        { label: 'Frequently asked questions', href: '/en/faq/' },
      ] },
    ];
footerColumns.push(locale === 'fr'
  ? { title: 'Informations', links: [
      { label: 'Mentions légales', href: '/fr/mentions-legales/' },
      { label: 'Confidentialité', href: '/fr/confidentialite/' },
      { label: 'Localisation Google Maps', href: site.geo.googleMapsUrl },
    ] }
  : locale === 'de'
    ? { title: 'Informationen', links: [
        { label: 'Impressum', href: '/de/impressum/' },
        { label: 'Datenschutz', href: '/de/datenschutz/' },
        { label: 'Standort auf Google Maps', href: site.geo.googleMapsUrl },
      ] }
    : { title: 'Information', links: [
        { label: 'Legal notice', href: '/en/legal-notice/' },
        { label: 'Privacy', href: '/en/privacy/' },
        { label: 'Location on Google Maps', href: site.geo.googleMapsUrl },
      ] });
const resolvedOgAlt = ogImageAlt ?? (locale === 'fr'
  ? 'Cours de kitesurf PKM dans le lagon du Morne à l’île Maurice'
  : locale === 'de'
    ? 'PKM-Kitesurfkurs in der Lagune von Le Morne auf Mauritius'
    : 'PKM kitesurf lesson in Le Morne lagoon, Mauritius');
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={(isPreview || noindex) ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
  <meta name="theme-color" content="#0A2C30" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : locale === 'de' ? 'de_DE' : 'en_GB'} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1277" />
  <meta property="og:image:alt" content={resolvedOgAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content={resolvedOgAlt} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class:list={{ 'scroll-refresh': scrollRefresh }}>
  <Topbar locale={locale} translations={translations} nav={NAV[locale] ?? []} scrollRefresh={scrollRefresh} />
  <main>
    <slot />
  </main>
  <Footer columns={footerColumns}>
    <p style="margin-top:16px;color:#7C9A98">
      © {new Date().getFullYear()} {site.name} — {site.spot}
    </p>
    <p style="margin:6px 0 0;color:#7C9A98;font-size:.76rem">
      {site.legal.legalName} · {site.legal.tourismLicenceAuthority} n° {site.legal.tourismLicence}
    </p>
  </Footer>
  <Dock
    tarifsHref={tarifsHref}
    waHref={waHref}
    tarifsLabel={locale === 'fr' ? 'Tarifs' : locale === 'de' ? 'Preise' : 'Prices'}
    waLabel={locale === 'fr' ? 'Réserver' : locale === 'de' ? 'Buchen' : 'Book'}
  />
  <AnalyticsConsent locale={locale} />

  <script>
    // Apparition progressive des sections au scroll — voir tokens.css pour le
    // pourquoi (inspiré du site Nissan Micra repéré par Max, ramené à ce
    // qu'un site statique économe peut se permettre). Zéro dépendance,
    // ~15 lignes, natif au navigateur (IntersectionObserver).
    // La toute première section de la page (le hero) n'est jamais concernée :
    // elle doit s'afficher immédiatement, sans attendre le JS.
    const sections = document.querySelectorAll('main section:not(:first-of-type):not([data-no-reveal])');
    sections.forEach((el) => el.setAttribute('data-reveal', ''));

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      sections.forEach((el) => io.observe(el));
    } else {
      // Navigateur trop ancien pour IntersectionObserver : on affiche tout,
      // pas de contenu caché derrière une fonctionnalité indisponible.
      sections.forEach((el) => el.classList.add('in'));
    }
  </script>
  {scrollRefresh && (
    <script>
      const body = document.body;
      let compactFrame = 0;
      const syncCompactHeader = () => {
        compactFrame = 0;
        body.classList.toggle('is-scrolled', window.scrollY > 60);
      };
      window.addEventListener('scroll', () => {
        if (!compactFrame) compactFrame = window.requestAnimationFrame(syncCompactHeader);
      }, { passive: true });
      syncCompactHeader();
    </script>
  )}
</body>
</html>
